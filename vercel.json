{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "pnpm player:build",
  "outputDirectory": "snack-player/dist",
  "rewrites": [
    { "source": "/p/:path*", "destination": "/index.html" },
    { "source": "/create", "destination": "/index.html" },
    { "source": "/stats", "destination": "/index.html" }
  ]
}
