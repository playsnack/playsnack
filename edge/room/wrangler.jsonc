// Deployed at https://snack-room.playsnack.workers.dev — owner steps: docs/edge-rooms.md §9.
// ROOM_TOKEN_SECRET is a secret: `wrangler secret put ROOM_TOKEN_SECRET` (never in this file).
// ROOM_SERVER_SECRET (optional secret, the same value as the stats API's env): sent as
// X-Room-Server with the rooms' game stats (docs/telemetry.md §9.7).
{
  "name": "snack-room",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-15",
  "durable_objects": {
    "bindings": [
      { "name": "GAMES", "class_name": "Game" },
      { "name": "ROOMS", "class_name": "Room" },
      { "name": "METER", "class_name": "Meter" }
    ]
  },
  // Free plan: Durable Objects must be SQLite-backed.
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Game", "Room", "Meter"] }],
  // Round content: the player's static data/multi-content/<game>.json (same files the mesh host uses).
  // STATS_URL: where the rooms' game stats go (the site's /api/ev; "" = none).
  // Room admission (#157, docs/room-admission.md): ALLOWED_ORIGINS = browser Origins that may open
  // rooms / mint codes (no Origin header = not a browser = allowed; "" = all). LEGACY_CREATE_UNTIL /
  // LEGACY_JOIN_UNTIL = until when codes from before v2 (10 symbols) may create / join a room
  // (ISO date or epoch ms; "" = no limit — today's behaviour). Set after the player's PR 2 is live.
  "vars": {
    "PACK_BASE_URL": "https://playsnack.pages.dev/data/multi-content",
    "STATS_URL": "https://playsnack.pages.dev/api/ev",
    "ALLOWED_ORIGINS": "https://playsnack.pages.dev,https://*.playsnack.pages.dev",
    // #206: live release of the signed codes = 2026-10-16 08:10 UTC (PR #227) → +24 h / +7 days.
    "LEGACY_CREATE_UNTIL": "2026-10-17T08:10:00Z",
    "LEGACY_JOIN_UNTIL": "2026-10-23T08:10:00Z"
  },
  // Rate limits (Workers Rate Limiting): only on the test server until a develop deploy shows the
  // binding works on the free plan (#157 step 0). Without them the Worker counts in its own
  // isolate (admit.js MemoryLimiter) and the PIN lock in the room still caps guesses at 50.
  "observability": { "enabled": false },
  // Test room server for the develop branch (docs/git-as-jira.md "Branch strategy"):
  // `wrangler deploy --env dev` → https://snack-room-dev.playsnack.workers.dev, its own Durable
  // Objects (test rooms never touch live ones) and its own ROOM_TOKEN_SECRET (set once by CI).
  // Bindings and vars are not inherited by an env, so they are repeated here. No game stats from
  // test rooms (STATS_URL ""). Same account → shares the free daily limits; test traffic only.
  "env": {
    "dev": {
      "name": "snack-room-dev",
      "durable_objects": {
        "bindings": [
          { "name": "GAMES", "class_name": "Game" },
          { "name": "ROOMS", "class_name": "Room" },
          { "name": "METER", "class_name": "Meter" }
        ]
      },
      "vars": {
        "PACK_BASE_URL": "https://develop.playsnack.pages.dev/data/multi-content",
        "STATS_URL": "",
        "ALLOWED_ORIGINS": "https://playsnack.pages.dev,https://*.playsnack.pages.dev,http://localhost:*,http://127.0.0.1:*",
        "LEGACY_CREATE_UNTIL": "",
        "LEGACY_JOIN_UNTIL": ""
      },
      // admit.js RATE; namespace ids are this account's own numbers (the live server gets others).
      "ratelimits": [
        { "name": "IP_RL", "namespace_id": "15701", "simple": { "limit": 120, "period": 60 } },
        { "name": "PIN_RL", "namespace_id": "15702", "simple": { "limit": 10, "period": 60 } },
        { "name": "PINIP_RL", "namespace_id": "15703", "simple": { "limit": 20, "period": 60 } },
        { "name": "MINT_RL", "namespace_id": "15704", "simple": { "limit": 10, "period": 60 } }
      ]
    }
  }
}
