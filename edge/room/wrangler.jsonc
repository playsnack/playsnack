// Deployed at https://snack-room.playsnack.workers.dev — owner steps: docs/edge-rooms.md §9.
// ROOM_TOKEN_SECRET is a secret: `wrangler secret put ROOM_TOKEN_SECRET` (never in this file).
// ROOM_SERVER_SECRET (optional secret, the same value as the stats API's env): sent as
// X-Room-Server with the rooms' game stats (docs/telemetry.md §9.7).
{
  "name": "snack-room",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-15",
  "durable_objects": {
    "bindings": [
      { "name": "GAMES", "class_name": "Game" },
      { "name": "ROOMS", "class_name": "Room" },
      { "name": "METER", "class_name": "Meter" }
    ]
  },
  // Free plan: Durable Objects must be SQLite-backed.
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Game", "Room", "Meter"] }],
  // Round content: the player's static data/multi-content/<game>.json (same files the mesh host uses).
  // STATS_URL: where the rooms' game stats go (the site's /api/ev; "" = none).
  "vars": { "PACK_BASE_URL": "https://playsnack.pages.dev/data/multi-content", "STATS_URL": "https://playsnack.pages.dev/api/ev" },
  "observability": { "enabled": false }
}
