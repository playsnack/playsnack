{
  "name": "@snack/room",
  "version": "0.1.0",
  "description": "Room engine \u2014 roster, shared tallies and synchronized game sessions. Pure; runs on the server or in the host player's browser.",
  "license": "UNLICENSED",
  "private": true,
  "type": "module",
  "main": "./src/room.js",
  "exports": {
    ".": "./src/room.js",
    "./actions": {
      "types": "./src/actions.d.ts",
      "default": "./src/actions.js"
    },
    "./relay-client": {
      "types": "./src/relayClient.d.ts",
      "default": "./src/relayClient.js"
    },
    "./mesh-client": {
      "types": "./src/meshClient.d.ts",
      "default": "./src/meshClient.js"
    },
    "./mqtt-bus": {
      "types": "./src/mqttBus.d.ts",
      "default": "./src/mqttBus.js"
    }
  },
  "scripts": {
    "test": "node --test --test-force-exit test/"
  },
  "dependencies": {
    "mqtt": "5.16.0"
  }
}
