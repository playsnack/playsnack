{
  "name": "@snack/player",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/sync-data.mjs && vite",
    "build": "node ../snack-server/tools/gen-tokens.mjs && node scripts/sync-data.mjs && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/",
    "sync-data": "node scripts/sync-data.mjs"
  },
  "dependencies": {
    "@snack/bite": "workspace:*",
    "@snack/bite-layout": "workspace:*",
    "@snack/bite-pixi": "workspace:*",
    "@snack/content": "workspace:*",
    "@snack/room": "workspace:*",
    "pixi.js": "^8.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "typescript": "^5.3.0",
    "vite": "^5.4.0"
  }
}
