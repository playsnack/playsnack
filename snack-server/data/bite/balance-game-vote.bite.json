  "start": "lobby",
  "phases": {
    "lobby": {
      "tick": [
        {
          "if": "sessionPhase === 'countdown'",
          "then": [
            {
              "go": "countdown"
            }
          ]
        },
        {
          "if": "sessionPhase === 'play'",
          "then": [
            {
              "go": "play"
            }
          ]
        },
        {
          "if": "sessionPhase === 'result'",
          "then": [
            {
              "go": "result"
            }
          ]
        }
      ]
    },
    "countdown": {
      "tick": [
        {
          "if": "sessionPhase === 'lobby'",
          "then": [
            {
              "go": "lobby"
            }
          ]
        },
        {
          "if": "sessionPhase === 'play'",
          "then": [
            {
              "go": "play"
            }
          ]
        },
        {
          "if": "sessionPhase === 'result'",
          "then": [
            {
              "go": "result"
            }
          ]
        }
      ]
    },
    "play": {
      "enter": [
        {
          "set": "myVote",
          "to": "''"
        },
        {
          "set": "myVoteRound",
          "to": "-2"
        }
      ],
      "tick": [
        {
          "if": "voteClock.round === roundIdx && voteClock.sessionNo === voteProgress.sessionNo && (seenVoteRound !== voteClock.round || seenVoteSession !== voteClock.sessionNo || seenVoteLeft !== voteClock.leftMs)",
          "then": [
            { "set": "seenVoteRound", "to": "voteClock.round" },
            { "set": "seenVoteSession", "to": "voteClock.sessionNo" },
            { "set": "seenVoteLeft", "to": "voteClock.leftMs" },
            { "set": "voteUntil", "to": "now + max(0, voteClock.leftMs)" }
          ]
        },
        {
          "if": "sessionPhase === 'lobby'",
          "then": [
            {
              "go": "lobby"
            }
          ]
        },
        {
          "if": "sessionPhase === 'countdown'",
          "then": [
            {
              "go": "countdown"
            }
          ]
        },
        {
          "if": "sessionPhase === 'result'",
          "then": [
            {
              "go": "result"
            }
          ]
        }
      ]
    },
    "result": {
      "tick": [
        {
          "if": "sessionPhase === 'lobby'",
          "then": [
            {
              "go": "lobby"
            }
          ]
        },
        {
          "if": "sessionPhase === 'countdown'",
          "then": [
            {
              "go": "countdown"
            }
          ]
        },
        {
          "if": "sessionPhase === 'play'",
          "then": [
            {
              "go": "play"
            }
          ]
        }
      ]
    }
  },
