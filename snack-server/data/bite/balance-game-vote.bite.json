            "width": 340,
            "size": 16,
            "weight": 700,
            "align": "center",
            "color": "{phase == 'play' && ((revealRound === roundIdx) || (voteProgress.round === roundIdx && voteProgress.of > 0 && voteProgress.voted >= voteProgress.of)) ? '#d9ff00' : '#9aa3af'}",
            "text": "{phase == 'play' ? ((revealRound === roundIdx) ? '결과 공개 🎉' : (voteProgress.round === roundIdx ? ((voteProgress.round === roundIdx && voteProgress.of > 0 && voteProgress.voted >= voteProgress.of) ? ('다 골랐어요! 곧 공개 (' + voteProgress.voted + '/' + voteProgress.of + ')') : (seenVoteRound === roundIdx && seenVoteSession === voteProgress.sessionNo && now >= voteUntil ? '시간 끝 · 결과 기다리는 중' : ('' + voteProgress.voted + '/' + voteProgress.of + '명 선택 · 시간 끝나면 공개'))) : '시간 안에 골라주세요')) : ''}"
          }
        ]
      },
      {
        "id": "resultScreen",
        "box": "column",
        "width": 390,
        "height": 844,
        "x": 0,
        "y": 0,
        "gap": 12,
        "pad": [
          59,
          16,
          34,
          16
        ],
        "show": "phase == 'result'",
        "children": [
          {
            "id": "navR",
            "use": "NavBar",
            "props": {
              "title": "밸런스게임",
              "subtitle": "끝!"
            }
          },
          {
            "id": "resCard",
            "box": "column",
            "width": 358,
            "height": 260,
            "gap": 10,
            "pad": 18,
            "align": "center",
            "justify": "center",
            "fill": "#16181c",
            "children": [
              {
                "id": "resEmoji",
                "text": "🎭",
                "size": 64,
                "align": "center"
              },
              {
                "id": "resTitle",
                "text": "밸런스게임 끝!",
                "width": 320,
                "size": 26,
                "weight": 700,
                "color": "#d9ff00",
                "align": "center"
              },
              {
                "id": "resSub",
                "text": "우리 방, 생각보다 많이 갈렸죠? 😏",
                "width": 320,
                "size": 16,
                "weight": 600,
                "color": "#d7dce3",
                "align": "center"
              }
            ]
          },
          {
            "id": "resSpacer",
            "box": "free",
            "width": "fill",
            "height": 1,
            "grow": 1
          },
          {
            "id": "againBtn",
            "use": "PrimaryButton",
            "props": {
              "label": "{roomMode == 'auto' ? '한 판 더 🔁' : '다시 하기 🔁'}"
            },
            "onTap": [
              {
                "if": "phase == 'result' && (roomMode == '' || roomMode == 'auto' || (roomMode == 'host' && iAmHost))",
                "then": [
                  {
                    "emit": "start",
                    "payload": {
                      "game": "balance",
                      "rounds": 5,
                      "roundMs": 10000,
                      "revealMs": 3500,
                      "hidden": true
                    }
                  }
                ]
              }
            ],
            "show": "(roomMode == '' || roomMode == 'auto' || (roomMode == 'host' && iAmHost))"
          },
          {
            "id": "againWait",
            "box": "column",
            "width": "fill",
            "height": 56,
            "gap": 2,
            "align": "center",
            "justify": "center",
            "fill": "#16181c",
            "stroke": {
              "color": "#2a2d33",
              "width": 1
            },
            "show": "!(roomMode == '' || roomMode == 'auto' || (roomMode == 'host' && iAmHost))",
            "children": [
              {
                "id": "againWaitMain",
                "text": "방장이 다시 시작하길 기다리는 중",
                "size": 16,
                "weight": 700,
                "color": "#d9ff00",
                "align": "center",
                "lines": 1
              },
              {
                "id": "againWaitSub",
                "text": "{'방장 · ' + hostNick}",
                "size": 13,
                "weight": 600,
                "color": "#9aa3af",
                "align": "center",
                "lines": 1
              }
            ]
          }
        ]
      }
    ]
  }
}
