  "start": "lobby",
  "phases": {
    "lobby": {
      "tick": [
        {
          "if": "sessionPhase === 'countdown'",
          "then": [
            {
              "go": "countdown"
            }
          ]
        },
        {
          "if": "sessionPhase === 'play'",
          "then": [
            {
              "go": "play"
            }
          ]
        },
        {
          "if": "sessionPhase === 'result'",
          "then": [
            {
              "go": "result"
            }
          ]
        }
      ]
    },
    "countdown": {
      "tick": [
        {
          "if": "sessionPhase === 'lobby'",
          "then": [
            {
              "go": "lobby"
            }
          ]
        },
        {
          "if": "sessionPhase === 'play'",
          "then": [
            {
              "go": "play"
            }
          ]
        },
        {
          "if": "sessionPhase === 'result'",
          "then": [
            {
              "go": "result"
            }
          ]
        }
      ]
    },
    "play": {
      "enter": [
        {
          "set": "goSeenAt",
          "to": "0"
        },
        {
          "set": "myReacted",
          "to": "false"
        },
        {
          "set": "myResult",
          "to": "''"
        },
        {
          "set": "reactMs",
          "to": "-1"
        }
      ],
      "tick": [
        {
          "if": "reactionGo && goSeenAt == 0",
          "then": [
            {
              "set": "goSeenAt",
              "to": "now"
            }
          ]
        },
        {
          "if": "sessionPhase === 'lobby'",
          "then": [
            {
              "go": "lobby"
            }
          ]
        },
        {
          "if": "sessionPhase === 'countdown'",
          "then": [
            {
              "go": "countdown"
            }
          ]
        },
        {
          "if": "sessionPhase === 'result'",
          "then": [
            {
              "go": "result"
            }
          ]
        }
      ]
    },
    "result": {
      "tick": [
        {
          "if": "sessionPhase === 'lobby'",
          "then": [
            {
              "go": "lobby"
            }
          ]
        },
        {
          "if": "sessionPhase === 'countdown'",
          "then": [
            {
              "go": "countdown"
            }
          ]
        },
        {
          "if": "sessionPhase === 'play'",
          "then": [
            {
              "go": "play"
            }
          ]
        }
      ]
    }
  },
