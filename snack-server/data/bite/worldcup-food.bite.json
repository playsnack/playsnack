{
  "bite": 1,
  "meta": {
    "name": "야식 월드컵"
  },
  "frame": [
    390,
    844
  ],
  "vars": {
    "current": [],
    "seed": [],
    "winners": [],
    "roundSize": 16,
    "matchIndex": 0,
    "champion": null
  },
  "data": {
    "url": "/api/content?kind=worldcup&theme=야식"
  },
  "start": "play",
  "phases": {
    "play": {},
    "result": {}
  },
  "view": {
    "box": "free",
    "children": [
      {
        "id": "bg",
        "box": "free",
        "width": 390,
        "height": 844,
        "x": 0,
        "y": 0,
        "fill": "#0b0c0e"
      },
      {
        "id": "playScreen",
        "box": "column",
        "width": 390,
        "height": 844,
        "x": 0,
        "y": 0,
        "gap": 10,
        "pad": [
          56,
          16,
          24,
          16
        ],
        "show": "phase == 'play'",
        "children": [
          {
            "id": "title",
            "text": "야식 월드컵",
            "size": 26,
            "font": "display",
            "color": "#ffffff"
          },
          {
            "id": "roundLabel",
            "text": "{phase == 'result' ? '16강 · 1번째 대결' : (current.length ? ('' + (roundSize === 16 ? '16강' : roundSize === 8 ? '8강' : roundSize === 4 ? '4강' : '결승') + ' · ' + (matchIndex + 1) + '번째 대결') : '불러오는 중…')}",
            "size": 15,
            "weight": 600,
            "color": "#9aa3af"
          },
          {
            "id": "optionA",
            "box": "free",
            "height": 300,
            "clip": true,
            "fill": "#16181c",
            "onTap": [
              {
                "if": "phase == 'play'",
                "then": [
                  {
                    "if": "roundSize === 2",
                    "then": [
                      {
                        "set": "champion",
                        "to": "current[matchIndex * 2]"
                      },
                      {
                        "go": "result"
                      }
                    ],
                    "else": [
                      {
                        "if": "matchIndex >= roundSize / 2 - 1",
                        "then": [
                          {
                            "set": "current",
                            "to": "winners.concat([current[matchIndex * 2]])"
                          },
                          {
                            "set": "winners",
                            "to": "[]"
                          },
                          {
                            "set": "roundSize",
                            "to": "roundSize / 2"
                          },
                          {
                            "set": "matchIndex",
                            "to": "0"
                          }
                        ],
                        "else": [
                          {
                            "set": "winners",
                            "to": "winners.concat([current[matchIndex * 2]])"
                          },
                          {
                            "set": "matchIndex",
                            "to": "matchIndex + 1"
                          }
                        ]
                      }
                    ]
                  }
                ]
              }
            ],
            "children": [
              {
                "id": "optionACard",
                "use": "ThingCard",
                "x": 0,
                "y": 0,
                "width": "fill",
                "height": "fill",
                "props": {
                  "name": "{current[matchIndex * 2] ? current[matchIndex * 2].name : ''}",
                  "emoji": "{current[matchIndex * 2] && current[matchIndex * 2].emoji ? current[matchIndex * 2].emoji : '🍽️'}"
                }
              }
            ]
          },
          {
            "id": "vs",
            "text": "VS",
            "width": 358,
            "size": 18,
            "weight": 800,
            "color": "#d9ff00",
            "align": "center"
          },
          {
            "id": "optionB",
            "box": "free",
            "height": 300,
            "clip": true,
            "fill": "#16181c",
            "onTap": [
              {
                "if": "phase == 'play'",
                "then": [
                  {
                    "if": "roundSize === 2",
                    "then": [
                      {
                        "set": "champion",
                        "to": "current[matchIndex * 2 + 1]"
                      },
                      {
                        "go": "result"
                      }
                    ],
                    "else": [
                      {
                        "if": "matchIndex >= roundSize / 2 - 1",
                        "then": [
                          {
                            "set": "current",
                            "to": "winners.concat([current[matchIndex * 2 + 1]])"
                          },
                          {
                            "set": "winners",
                            "to": "[]"
                          },
                          {
                            "set": "roundSize",
                            "to": "roundSize / 2"
                          },
                          {
                            "set": "matchIndex",
                            "to": "0"
                          }
                        ],
                        "else": [
                          {
                            "set": "winners",
                            "to": "winners.concat([current[matchIndex * 2 + 1]])"
                          },
                          {
                            "set": "matchIndex",
                            "to": "matchIndex + 1"
                          }
                        ]
                      }
                    ]
                  }
                ]
              }
            ],
            "children": [
              {
                "id": "optionBCard",
                "use": "ThingCard",
                "x": 0,
                "y": 0,
                "width": "fill",
                "height": "fill",
                "props": {
                  "name": "{current[matchIndex * 2 + 1] ? current[matchIndex * 2 + 1].name : ''}",
                  "emoji": "{current[matchIndex * 2 + 1] && current[matchIndex * 2 + 1].emoji ? current[matchIndex * 2 + 1].emoji : '🍽️'}"
                }
              }
            ]
          }
        ]
      },
      {
        "id": "resultScreen",
        "box": "column",
        "width": 390,
        "height": 844,
        "x": 0,
        "y": 0,
        "gap": 14,
        "pad": [
          80,
          24,
          40,
          24
        ],
        "align": "center",
        "justify": "center",
        "fill": "#0b0c0e",
        "show": "phase == 'result'",
        "children": [
          {
            "id": "resultTop",
            "text": "🏆 최종 우승",
            "size": 16,
            "weight": 700,
            "color": "#d9ff00"
          },
          {
            "id": "winnerEmoji",
            "text": "{champion && champion.emoji ? champion.emoji : '🍽️'}",
            "size": 140,
            "align": "center"
          },
          {
            "id": "winnerName",
            "text": "{phase == 'result' ? (champion ? champion.name : '') : ''}",
            "size": 30,
            "font": "display",
            "color": "#ffffff"
          },
          {
            "id": "winnerSub",
            "text": "수많은 대결을 뚫고 뽑힌 오늘의 1위!",
            "width": 320,
            "size": 14,
            "color": "#9aa3af",
            "align": "center"
          },
          {
            "id": "restartBtn",
            "box": "row",
            "width": 200,
            "height": 52,
            "align": "center",
            "justify": "center",
            "fill": "#d9ff00",
            "onTap": [
              {
                "if": "phase == 'result'",
                "then": [
                  {
                    "set": "current",
                    "to": "seed"
                  },
                  {
                    "set": "winners",
                    "to": "[]"
                  },
                  {
                    "set": "roundSize",
                    "to": "16"
                  },
                  {
                    "set": "matchIndex",
                    "to": "0"
                  },
                  {
                    "set": "champion",
                    "to": "null"
                  },
                  {
                    "go": "play"
                  }
                ]
              }
            ],
            "children": [
              {
                "id": "restartLabel",
                "text": "다시하기",
                "size": 16,
                "weight": 700,
                "color": "#0b0c0e"
              }
            ]
          }
        ]
      }
    ]
  },
  "components": {
    "ThingCard": {
      "props": {
        "name": "",
        "emoji": ""
      },
      "view": {
        "box": "column",
        "pad": 16,
        "gap": 12,
        "align": "center",
        "justify": "center",
        "fill": "#16181C",
        "stroke": {
          "color": "#3A3F47",
          "width": 2
        },
        "shadow": {
          "x": 0,
          "y": 6,
          "blur": 0,
          "color": "#000000"
        },
        "children": [
          {
            "text": "{props.emoji}",
            "size": 88,
            "align": "center"
          },
          {
            "text": "{props.name}",
            "font": "display",
            "size": 30,
            "color": "#FFFFFF",
            "align": "center",
            "lines": 1
          }
        ]
      }
    }
  }
}
