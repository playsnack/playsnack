  "start": "lobby",
  "phases": {
    "lobby": {
      "tick": [
        {
          "if": "sessionPhase === 'countdown'",
          "then": [
            {
              "go": "countdown"
            }
          ]
        },
        {
          "if": "sessionPhase === 'play'",
          "then": [
            {
              "go": "play"
            }
          ]
        },
        {
          "if": "sessionPhase === 'result'",
          "then": [
            {
              "go": "result"
            }
          ]
        }
      ]
    },
    "countdown": {
      "tick": [
        {
          "if": "sessionPhase === 'lobby'",
          "then": [
            {
              "go": "lobby"
            }
          ]
        },
        {
          "if": "sessionPhase === 'play'",
          "then": [
            {
              "go": "play"
            }
          ]
        },
        {
          "if": "sessionPhase === 'result'",
          "then": [
            {
              "go": "result"
            }
          ]
        }
      ]
    },
    "play": {
      "enter": [
        {
          "set": "myTaps",
          "to": "0"
        },
        {
          "set": "sentTaps",
          "to": "0"
        },
        {
          "set": "sentAt",
          "to": "0"
        }
      ],
      "tick": [
        {
          "if": "myTaps > sentTaps && now - sentAt >= 250",
          "then": [
            {
              "emit": "taps",
              "payload": {
                "count": "{myTaps}"
              }
            },
            {
              "set": "sentTaps",
              "to": "myTaps"
            },
            {
              "set": "sentAt",
              "to": "now"
            }
          ]
        },
        {
          "if": "sessionPhase === 'lobby'",
          "then": [
            {
              "go": "lobby"
            }
          ]
        },
        {
          "if": "sessionPhase === 'countdown'",
          "then": [
            {
              "go": "countdown"
            }
          ]
        },
        {
          "if": "sessionPhase === 'result'",
          "then": [
            {
              "go": "result"
            }
          ]
        }
      ]
    },
    "result": {
      "enter": [
        {
          "set": "sentTaps",
          "to": "-1"
        }
      ],
      "tick": [
        {
          "if": "myTaps > sentTaps",
          "then": [
            {
              "emit": "taps",
              "payload": {
                "count": "{myTaps}"
              }
            },
            {
              "set": "sentTaps",
              "to": "myTaps"
            }
          ]
        },
        {
          "if": "sessionPhase === 'lobby'",
          "then": [
            {
              "go": "lobby"
            }
          ]
        },
        {
          "if": "sessionPhase === 'countdown'",
          "then": [
            {
              "go": "countdown"
            }
          ]
        },
        {
          "if": "sessionPhase === 'play'",
          "then": [
            {
              "go": "play"
            }
          ]
        }
      ]
    }
  },
