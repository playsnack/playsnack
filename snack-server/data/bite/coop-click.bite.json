            "onTap": [
              {
                "if": "phase == 'result' && (roomMode == '' || roomMode == 'auto' || (roomMode == 'host' && iAmHost))",
                "then": [
                  {
                    "set": "myTaps",
                    "to": "0"
                  },
                  {
                    "set": "sentTaps",
                    "to": "0"
                  },
                  {
                    "emit": "start",
                    "payload": {
                      "duration": 60000,
                      "goal": 300
                    }
                  }
                ]
              }
            ],
            "show": "(roomMode == '' || roomMode == 'auto' || (roomMode == 'host' && iAmHost))"
          },
          {
            "id": "againWait",
            "box": "column",
            "width": "fill",
            "height": 56,
            "gap": 2,
            "align": "center",
            "justify": "center",
            "fill": "#16181c",
            "stroke": {
              "color": "#2a2d33",
              "width": 1
            },
            "show": "!(roomMode == '' || roomMode == 'auto' || (roomMode == 'host' && iAmHost))",
            "children": [
              {
                "id": "againWaitMain",
                "text": "방장이 다시 시작하길 기다리는 중",
                "size": 16,
                "weight": 700,
                "color": "#d9ff00",
                "align": "center",
                "lines": 1
              },
              {
                "id": "againWaitSub",
                "text": "{'방장 · ' + hostNick}",
                "size": 13,
                "weight": 600,
                "color": "#9aa3af",
                "align": "center",
                "lines": 1
              }
            ]
          }
        ]
      }
    ]
  }
}
