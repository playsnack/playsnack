            }
          },
          {
            "id": "resultCard",
            "box": "column",
            "height": "hug",
            "gap": 14,
            "pad": 22,
            "align": "center",
            "fill": "#16181c",
            "children": [
              {
                "id": "resultEmoji",
                "text": "{phase == 'result' ? (('' + (cat >= dog && cat >= rabbit && cat >= fox ? '🐱' : dog >= rabbit && dog >= fox ? '🐶' : rabbit >= fox ? '🐰' : '🦊'))) : '🐱'}",
                "size": 84,
                "font": "display",
                "color": "#ffffff",
                "align": "center"
              },
              {
                "id": "resultTitle",
                "text": "{phase == 'result' ? (('' + (cat >= dog && cat >= rabbit && cat >= fox ? '고요한 달빛 고양이' : dog >= rabbit && dog >= fox ? '햇살 가득 강아지' : rabbit >= fox ? '말랑한 꽃밭 토끼' : '영리한 별빛 여우'))) : '고요한 달빛 고양이'}",
                "size": 29,
                "weight": 700,
                "color": "#ffffff",
                "align": "center"
              },
              {
                "id": "resultDesc",
                "text": "{phase == 'result' ? (('' + (cat >= dog && cat >= rabbit && cat >= fox ? '혼자만의 리듬을 소중히 여기고, 중요한 순간에는 누구보다 섬세하게 판단하는 타입이에요.' : dog >= rabbit && dog >= fox ? '사람들과 함께할 때 가장 빛나요. 따뜻한 에너지로 주변을 움직이게 만드는 든든한 캐릭터예요.' : rabbit >= fox ? '작은 감정과 분위기를 잘 알아차리는 다정한 타입이에요. 곁에 있으면 마음이 부드러워져요.' : '호기심과 전략 감각이 뛰어난 타입이에요. 새로운 길을 발견하고 멋지게 방향을 잡아주는 캐릭터예요.'))) : '혼자만의 리듬을 소중히 여기고, 중요한 순간에는 누구보다 섬세하게 판단하는 타입이에요.'}",
                "size": 16,
                "weight": 500,
                "color": "#d7dce3",
                "align": "center"
              },
              {
                "id": "restartBtn",
                "use": "Button",
                "props": {
                  "label": "다시하기"
                },
                "onTap": [
                  {
                    "if": "phase == 'result'",
                    "then": [
                      {
                        "set": "cat",
                        "to": "0"
                      },
                      {
                        "set": "dog",
                        "to": "0"
                      },
                      {
                        "set": "rabbit",
                        "to": "0"
                      },
                      {
                        "set": "fox",
                        "to": "0"
                      },
                      {
                        "go": "q1"
                      }
                    ]
                  }
                ]
              }
            ]
          }
        ]
      }
    ]
  }
}
