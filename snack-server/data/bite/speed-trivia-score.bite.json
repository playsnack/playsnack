    "PrimaryButton": {
      "props": {
        "label": "확인"
      },
      "view": {
        "id": "root",
        "box": "row",
        "height": 56,
        "align": "center",
        "justify": "center",
        "fill": "#d9ff00",
        "children": [
          {
            "id": "lbl",
            "text": "{props.label}",
            "size": 17,
            "weight": 800,
            "color": "#0b0c0e"
          }
        ]
      }
    }
  },
  "start": "lobby",
  "phases": {
    "lobby": {
      "tick": [
        {
          "if": "sessionPhase === 'countdown'",
          "then": [
            {
              "go": "countdown"
            }
          ]
        },
        {
          "if": "sessionPhase === 'play'",
          "then": [
            {
              "go": "play"
            }
          ]
        },
        {
          "if": "sessionPhase === 'result'",
          "then": [
            {
              "go": "result"
            }
          ]
        }
      ]
    },
    "countdown": {
      "tick": [
        {
          "if": "sessionPhase === 'lobby'",
          "then": [
            {
              "go": "lobby"
            }
          ]
        },
        {
          "if": "sessionPhase === 'play'",
          "then": [
            {
              "go": "play"
            }
          ]
        },
        {
          "if": "sessionPhase === 'result'",
          "then": [
            {
              "go": "result"
            }
          ]
        }
      ]
    },
    "play": {
      "enter": [
        {
          "set": "myAnswer",
          "to": "-1"
        },
        {
          "set": "myAnswerRound",
          "to": "-2"
        },
        {
          "set": "seenRound",
          "to": "-1"
        },
        {
          "set": "myMs",
          "to": "-1"
        }
      ],
      "tick": [
        {
          "if": "roundIdx >= 0 && roundAnswer < 0 && seenRound !== roundIdx",
          "then": [
            {
              "set": "seenRound",
              "to": "roundIdx"
            },
            {
              "set": "seenAt",
              "to": "now"
            }
          ]
        },
        {
          "if": "sessionPhase === 'lobby'",
          "then": [
            {
              "go": "lobby"
            }
          ]
        },
        {
          "if": "sessionPhase === 'countdown'",
          "then": [
            {
              "go": "countdown"
            }
          ]
        },
        {
          "if": "sessionPhase === 'result'",
          "then": [
            {
              "go": "result"
            }
          ]
        }
      ]
    },
    "result": {
      "tick": [
        {
          "if": "sessionPhase === 'lobby'",
          "then": [
            {
              "go": "lobby"
            }
          ]
        },
        {
          "if": "sessionPhase === 'countdown'",
          "then": [
            {
              "go": "countdown"
            }
          ]
        },
        {
          "if": "sessionPhase === 'play'",
          "then": [
            {
              "go": "play"
            }
          ]
        }
      ]
    }
  },
  "view": {
    "box": "free",
    "children": [
      {
        "id": "bg",
        "box": "free",
        "width": 390,
        "height": 844,
        "x": 0,
        "y": 0,
        "fill": "#0b0c0e"
      },
      {
        "id": "lobbyScreen",
        "box": "column",
        "width": 390,
        "height": 844,
        "x": 0,
        "y": 0,
        "gap": 10,
        "pad": [
          59,
          16,
          34,
          16
        ],
        "show": "phase == 'lobby'",
        "children": [
          {
            "id": "navL",
            "use": "NavBar",
            "props": {
              "title": "{quizInfo.custom ? (quizInfo.about + ' 맞히기') : '스피드 퀴즈'}",
              "subtitle": "대기실"
            }
          },
          {
            "id": "lobbyIntro",
            "box": "column",
            "width": "fill",
            "height": 220,
            "gap": 8,
            "pad": 18,
            "align": "center",
            "justify": "center",
            "fill": "#16181c",
            "children": [
              {
                "id": "lobbyEmoji",
                "text": "🧠",
                "size": 48,
                "align": "center"
              },
              {
                "id": "lobbyTitle",
                "text": "{quizInfo.custom ? quizInfo.title : '같은 문제를 동시에!'}",
                "width": 320,
                "size": 22,
                "font": "display",
                "color": "#ffffff",
                "align": "center",
                "lines": 2
              },
              {
                "id": "lobbySub",
                "text": "{quizInfo.custom ? ('' + quizInfo.count + '문제 · ' + (quizInfo.about) + ' 님에 대한 퀴즈') : '빠르고 정확할수록 고득점'}",
                "width": 320,
                "size": 15,
                "weight": 600,
                "color": "#9aa3af",
                "align": "center"
              }
            ]
          },
          {
            "id": "lobbyCard",
            "box": "column",
            "width": 358,
            "height": 160,
            "gap": 10,
            "pad": 18,
            "align": "center",
            "justify": "center",
            "fill": "#16181c",
            "children": [
              {
                "id": "lobbyCount",
                "text": "{phase == 'lobby' ? (('참가자 ' + (roster.length) + '명')) : '참가자 1명'}",
                "width": 320,
                "size": 26,
                "font": "display",
                "color": "#d9ff00",
                "align": "center"
              },
              {
                "id": "lobbyNames",
                "text": "{phase == 'lobby' ? (roster.length > 0 ? roster.join(' · ') : '입장 중…') : ''}",
                "width": 320,
                "size": 15,
                "weight": 600,
                "color": "#9aa3af",
                "align": "center"
              }
            ]
          },
          {
            "id": "lobbyHint",
            "text": "{quizInfo.custom && roster.length < 2 ? '친구를 초대하면 같이 할 수 있어요' : (quizInfo.custom ? (iAmSubject ? '친구들이 나를 얼마나 알까? 시작을 눌러요' : (quizInfo.about + ' 님을 얼마나 알까? 빠를수록 고득점')) : (roster.length < 2 ? '친구를 초대하면 같이 할 수 있어요 · 혼자서도 OK' : '같은 문제를 동시에! 빠르고 정확할수록 고득점'))}",
            "width": 340,
            "size": 14,
            "weight": 500,
            "color": "#9aa3af",
            "align": "center"
          },
          {
            "id": "lobbySpacer",
            "box": "free",
            "width": "fill",
            "height": 1,
            "grow": 1
          },
          {
            "id": "startBtn",
            "use": "PrimaryButton",
            "props": {
              "label": "{quizInfo.custom && roster.length < 2 ? '친구를 기다리는 중…' : '시작하기 🚀'}"
            },
            "onTap": [
              {
                "if": "phase == 'lobby' && !(quizInfo.custom && roster.length < 2)",
                "then": [
                  {
                    "set": "myAnswer",
                    "to": "-1"
                  },
                  {
                    "emit": "start",
                    "payload": {
                      "game": "trivia",
                      "quiz": true,
                      "rounds": 6,
                      "answerMs": 9000,
                      "revealMs": 3000
                    }
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "id": "countdownScreen",
        "box": "column",
        "width": 390,
        "height": 844,
        "x": 0,
        "y": 0,
        "gap": 10,
        "pad": [
          59,
          16,
          34,
          16
        ],
        "show": "phase == 'countdown'",
        "children": [
          {
            "id": "navC",
            "use": "NavBar",
            "props": {
              "title": "{quizInfo.custom ? (quizInfo.about + ' 맞히기') : '스피드 퀴즈'}",
