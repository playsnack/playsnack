            "height": 420,
            "gap": 8,
            "pad": 18,
            "align": "center",
            "justify": "center",
            "fill": "#16181c",
            "children": [
              {
                "id": "cdNum",
                "text": "{phase == 'countdown' ? (sessionCountdown > 0 ? ('' + (sessionCountdown)) : 'GO!') : '3'}",
                "width": 320,
                "size": 140,
                "font": "display",
                "color": "#d9ff00",
                "align": "center"
              },
              {
                "id": "cdLabel",
                "text": "{phase == 'countdown' ? (sessionCountdown > 0 ? '준비…' : '퀴즈!') : '준비…'}",
                "width": 320,
                "size": 20,
                "weight": 700,
                "color": "#ffffff",
                "align": "center"
              }
            ]
          }
        ]
      },
      {
        "id": "playScreen",
        "box": "column",
        "width": 390,
        "height": 844,
        "x": 0,
        "y": 0,
        "gap": 10,
        "pad": [
          59,
          16,
          34,
          16
        ],
        "show": "phase == 'play'",
        "children": [
          {
            "id": "navP",
            "use": "NavBar",
            "props": {
              "title": "{quizInfo.custom ? (quizInfo.about + ' 맞히기') : '스피드 퀴즈'}",
              "subtitle": "{phase == 'play' ? ('' + roundNum + ' / ' + roundTotal) : ''}"
            }
          },
          {
            "id": "timerRow",
            "box": "row",
            "width": "fill",
            "height": 28,
            "gap": 12,
            "align": "center",
            "children": [
              {
                "id": "timerTrack",
                "box": "free",
                "height": 10,
                "grow": 1,
                "fill": "#1e2127",
                "children": [
                  {
                    "id": "timerBar",
                    "box": "free",
                    "x": 0,
                    "y": 0,
                    "height": 10,
                    "width": "{phase == 'play' && roundAnswer < 0 && seenRound === roundIdx ? round(298 * max(0, (quizInfo.answerMs || 9000) - (now - seenAt)) / (quizInfo.answerMs || 9000)) : 0}",
                    "fill": "#d9ff00"
                  }
                ]
              },
              {
                "id": "timerSecs",
                "text": "{phase == 'play' && roundAnswer < 0 && seenRound === roundIdx ? ('' + ceil(max(0, (quizInfo.answerMs || 9000) - (now - seenAt)) / 1000)) : ''}",
                "width": 48,
                "size": 22,
                "font": "display",
                "color": "#ffffff",
                "align": "right"
              }
            ]
          },
          {
            "id": "qText",
            "text": "{phase == 'play' ? (roundContent.q || '') : ''}",
            "width": 350,
            "size": 22,
            "weight": 800,
            "color": "#ffffff",
            "align": "center",
            "lines": 4
          },
          {
            "id": "statusText",
            "text": "{phase == 'play' ? (roundAnswer >= 0 ? (iAmSubject ? '정답 공개!' : (myAnswerRound === roundIdx ? (myAnswer === roundAnswer ? ('정답! ✓ ' + round(myMs / 100) / 10 + '초') : '땡! ✗') : '시간 초과 ⌛')) : (iAmSubject ? ('친구들이 고르는 중… (' + quizProgress.answered + '/' + quizProgress.of + ')') : (myAnswerRound === roundIdx ? '선택 완료! 공개를 기다려요' : (seenRound === roundIdx && now - seenAt >= (quizInfo.answerMs || 9000) ? '시간 초과 ⌛' : (quizInfo.custom ? (quizInfo.about + ' 님을 맞혀라!') : '⏱ 정답을 빠르게!'))))) : ''}",
            "width": 340,
            "size": 15,
            "weight": 700,
            "color": "{phase == 'play' ? (roundAnswer >= 0 ? (iAmSubject ? '#ffffff' : (myAnswerRound === roundIdx && myAnswer === roundAnswer ? '#22c55e' : '#ff5a5f')) : (iAmSubject || myAnswerRound === roundIdx ? '#9aa3af' : '#d9ff00')) : '#d9ff00'}",
            "align": "center"
          },
          {
            "id": "tile0",
            "box": "row",
            "width": "fill",
            "height": 64,
            "pad": [
              8,
              12,
              8,
              12
            ],
            "align": "center",
            "justify": "center",
            "fill": "{phase == 'play' ? (roundAnswer >= 0 ? (0 === roundAnswer ? '#18351f' : (myAnswerRound === roundIdx && myAnswer === 0 ? '#3a171a' : '#16181c')) : (myAnswerRound === roundIdx && myAnswer === 0 ? '#d9ff00' : '#1e2127')) : '#1e2127'}",
            "stroke": {
              "color": "{phase == 'play' && roundAnswer >= 0 && 0 === roundAnswer ? '#22c55e' : '#2a2d33'}",
              "width": 2
            },
            "onTap": [
              {
                "if": "phase == 'play' && !iAmSubject && myAnswerRound !== roundIdx && roundAnswer < 0 && seenRound === roundIdx && now - seenAt < (quizInfo.answerMs || 9000)",
                "then": [
                  {
                    "set": "myAnswer",
                    "to": "0"
                  },
                  {
                    "set": "myAnswerRound",
                    "to": "roundIdx"
                  },
                  {
                    "set": "myMs",
                    "to": "now - seenAt"
                  },
                  {
                    "emit": "answer",
                    "payload": {
                      "option": 0,
                      "ms": "{myMs}"
                    }
                  }
                ]
              }
            ],
            "children": [
              {
                "id": "tile0Txt",
                "text": "{phase == 'play' ? ((roundAnswer >= 0 ? (0 === roundAnswer ? '✓ ' : (myAnswerRound === roundIdx && myAnswer === 0 ? '✗ ' : '')) : '') + ((roundContent.options && roundContent.options[0]) || '')) : ''}",
                "width": 320,
                "size": 19,
                "weight": 800,
                "color": "{phase == 'play' && roundAnswer < 0 && myAnswerRound === roundIdx && myAnswer === 0 ? '#0b0c0e' : (phase == 'play' && roundAnswer >= 0 && 0 !== roundAnswer && !(myAnswerRound === roundIdx && myAnswer === 0) ? '#9aa3af' : '#ffffff')}",
                "align": "center",
                "lines": 2
              }
            ]
          },
          {
            "id": "tile1",
            "box": "row",
            "width": "fill",
            "height": 64,
            "pad": [
              8,
              12,
              8,
              12
            ],
            "align": "center",
            "justify": "center",
            "fill": "{phase == 'play' ? (roundAnswer >= 0 ? (1 === roundAnswer ? '#18351f' : (myAnswerRound === roundIdx && myAnswer === 1 ? '#3a171a' : '#16181c')) : (myAnswerRound === roundIdx && myAnswer === 1 ? '#d9ff00' : '#1e2127')) : '#1e2127'}",
            "stroke": {
              "color": "{phase == 'play' && roundAnswer >= 0 && 1 === roundAnswer ? '#22c55e' : '#2a2d33'}",
              "width": 2
            },
            "onTap": [
              {
                "if": "phase == 'play' && !iAmSubject && myAnswerRound !== roundIdx && roundAnswer < 0 && seenRound === roundIdx && now - seenAt < (quizInfo.answerMs || 9000)",
                "then": [
                  {
                    "set": "myAnswer",
                    "to": "1"
                  },
                  {
                    "set": "myAnswerRound",
                    "to": "roundIdx"
                  },
                  {
                    "set": "myMs",
                    "to": "now - seenAt"
                  },
                  {
                    "emit": "answer",
                    "payload": {
                      "option": 1,
                      "ms": "{myMs}"
                    }
                  }
                ]
              }
            ],
            "children": [
              {
                "id": "tile1Txt",
                "text": "{phase == 'play' ? ((roundAnswer >= 0 ? (1 === roundAnswer ? '✓ ' : (myAnswerRound === roundIdx && myAnswer === 1 ? '✗ ' : '')) : '') + ((roundContent.options && roundContent.options[1]) || '')) : ''}",
                "width": 320,
                "size": 19,
                "weight": 800,
                "color": "{phase == 'play' && roundAnswer < 0 && myAnswerRound === roundIdx && myAnswer === 1 ? '#0b0c0e' : (phase == 'play' && roundAnswer >= 0 && 1 !== roundAnswer && !(myAnswerRound === roundIdx && myAnswer === 1) ? '#9aa3af' : '#ffffff')}",
                "align": "center",
                "lines": 2
              }
            ]
          },
          {
            "id": "tile2",
            "box": "row",
            "width": "fill",
            "height": 64,
            "pad": [
              8,
              12,
              8,
              12
            ],
            "align": "center",
            "justify": "center",
            "show": "phase == 'play' ? (roundContent.options && roundContent.options.length > 2) : true",
            "fill": "{phase == 'play' ? (roundAnswer >= 0 ? (2 === roundAnswer ? '#18351f' : (myAnswerRound === roundIdx && myAnswer === 2 ? '#3a171a' : '#16181c')) : (myAnswerRound === roundIdx && myAnswer === 2 ? '#d9ff00' : '#1e2127')) : '#1e2127'}",
            "stroke": {
              "color": "{phase == 'play' && roundAnswer >= 0 && 2 === roundAnswer ? '#22c55e' : '#2a2d33'}",
              "width": 2
            },
            "onTap": [
              {
                "if": "phase == 'play' && !iAmSubject && myAnswerRound !== roundIdx && roundAnswer < 0 && seenRound === roundIdx && now - seenAt < (quizInfo.answerMs || 9000)",
                "then": [
                  {
                    "set": "myAnswer",
                    "to": "2"
                  },
                  {
                    "set": "myAnswerRound",
                    "to": "roundIdx"
                  },
                  {
                    "set": "myMs",
                    "to": "now - seenAt"
                  },
                  {
                    "emit": "answer",
                    "payload": {
                      "option": 2,
                      "ms": "{myMs}"
                    }
                  }
                ]
              }
            ],
            "children": [
              {
                "id": "tile2Txt",
                "text": "{phase == 'play' ? ((roundAnswer >= 0 ? (2 === roundAnswer ? '✓ ' : (myAnswerRound === roundIdx && myAnswer === 2 ? '✗ ' : '')) : '') + ((roundContent.options && roundContent.options[2]) || '')) : ''}",
                "width": 320,
                "size": 19,
                "weight": 800,
                "color": "{phase == 'play' && roundAnswer < 0 && myAnswerRound === roundIdx && myAnswer === 2 ? '#0b0c0e' : (phase == 'play' && roundAnswer >= 0 && 2 !== roundAnswer && !(myAnswerRound === roundIdx && myAnswer === 2) ? '#9aa3af' : '#ffffff')}",
                "align": "center",
                "lines": 2
              }
            ]
          },
          {
            "id": "tile3",
            "box": "row",
            "width": "fill",
            "height": 64,
            "pad": [
              8,
              12,
              8,
              12
            ],
            "align": "center",
            "justify": "center",
            "show": "phase == 'play' ? (roundContent.options && roundContent.options.length > 3) : true",
            "fill": "{phase == 'play' ? (roundAnswer >= 0 ? (3 === roundAnswer ? '#18351f' : (myAnswerRound === roundIdx && myAnswer === 3 ? '#3a171a' : '#16181c')) : (myAnswerRound === roundIdx && myAnswer === 3 ? '#d9ff00' : '#1e2127')) : '#1e2127'}",
            "stroke": {
              "color": "{phase == 'play' && roundAnswer >= 0 && 3 === roundAnswer ? '#22c55e' : '#2a2d33'}",
              "width": 2
            },
            "onTap": [
              {
                "if": "phase == 'play' && !iAmSubject && myAnswerRound !== roundIdx && roundAnswer < 0 && seenRound === roundIdx && now - seenAt < (quizInfo.answerMs || 9000)",
                "then": [
                  {
                    "set": "myAnswer",
                    "to": "3"
                  },
                  {
                    "set": "myAnswerRound",
                    "to": "roundIdx"
                  },
                  {
                    "set": "myMs",
                    "to": "now - seenAt"
                  },
                  {
                    "emit": "answer",
                    "payload": {
                      "option": 3,
                      "ms": "{myMs}"
                    }
                  }
                ]
              }
            ],
            "children": [
              {
                "id": "tile3Txt",
                "text": "{phase == 'play' ? ((roundAnswer >= 0 ? (3 === roundAnswer ? '✓ ' : (myAnswerRound === roundIdx && myAnswer === 3 ? '✗ ' : '')) : '') + ((roundContent.options && roundContent.options[3]) || '')) : ''}",
                "width": 320,
                "size": 19,
                "weight": 800,
