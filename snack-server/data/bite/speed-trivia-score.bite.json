{
  "bite": 1,
  "meta": {
    "name": "스피드 퀴즈",
    "multi": true
  },
  "frame": [
    390,
    844
  ],
  "vars": {
    "sessionPhase": "lobby",
    "sessionCountdown": 0,
    "roster": [],
    "roundContent": {
      "q": "",
      "options": [
        "",
        "",
        "",
        ""
      ]
    },
    "roundNum": 0,
    "roundTotal": 0,
    "roundIdx": -1,
    "roundAnswer": -1,
    "raceBoard": [],
    "myAnswer": -1,
    "myAnswerRound": -2,
    "resultView": {
      "mode": "",
      "kicker": "",
      "headline": "",
      "mine": "",
      "ranks": [],
      "duo": {
        "line": "",
        "score": "",
        "tier": ""
      },
      "emptyText": "",
      "questions": []
    },
    "reactionStage": "",
    "canMake": false
  },
  "components": {
    "NavBar": {
      "props": {
        "title": "",
        "subtitle": ""
      },
      "view": {
        "id": "root",
        "box": "column",
        "height": "hug",
        "gap": 2,
        "children": [
          {
            "id": "title",
            "text": "{props.title}",
            "size": 28,
            "font": "display",
            "color": "#ffffff"
          },
          {
            "id": "sub",
            "text": "{props.subtitle}",
            "size": 15,
            "weight": 500,
            "color": "#9aa3af"
          }
        ]
      }
    },
    "GhostButton": {
      "props": {
        "label": "취소"
      },
      "view": {
        "id": "root",
        "box": "row",
        "height": 50,
        "align": "center",
        "justify": "center",
        "fill": "#1e2127",
        "stroke": {
          "color": "#2a2d33",
          "width": 1
        },
        "children": [
          {
            "id": "lbl",
            "text": "{props.label}",
            "size": 17,
            "weight": 600,
            "color": "#ffffff"
          }
        ]
      }
    },
    "StatCard": {
      "props": {
        "label": "",
        "value": "0"
      },
      "view": {
        "id": "root",
        "box": "column",
        "height": "hug",
        "gap": 6,
        "pad": 20,
        "fill": "#16181c",
        "children": [
          {
            "id": "lbl",
            "text": "{props.label}",
            "size": 14,
            "weight": 600,
            "color": "#9aa3af"
          },
          {
            "id": "val",
            "text": "{props.value}",
            "size": 40,
            "font": "display",
            "color": "#ffffff"
          }
        ]
      }
    },
    "PrimaryButton": {
      "props": {
        "label": "확인"
      },
      "view": {
        "id": "root",
        "box": "row",
        "height": 56,
        "align": "center",
        "justify": "center",
        "fill": "#d9ff00",
        "children": [
          {
            "id": "lbl",
            "text": "{props.label}",
            "size": 17,
            "weight": 800,
            "color": "#0b0c0e"
          }
        ]
      }
    }
  },
  "start": "lobby",
  "phases": {
    "lobby": {
      "tick": [
        {
          "if": "sessionPhase === 'countdown'",
          "then": [
            {
              "go": "countdown"
            }
          ]
        },
        {
          "if": "sessionPhase === 'play'",
          "then": [
            {
              "go": "play"
            }
          ]
        },
        {
          "if": "sessionPhase === 'result'",
          "then": [
            {
              "go": "result"
            }
          ]
        }
      ]
    },
    "countdown": {
      "tick": [
        {
          "if": "sessionPhase === 'lobby'",
          "then": [
            {
              "go": "lobby"
            }
          ]
        },
        {
          "if": "sessionPhase === 'play'",
          "then": [
            {
              "go": "play"
            }
          ]
        },
        {
          "if": "sessionPhase === 'result'",
          "then": [
            {
              "go": "result"
            }
          ]
        }
      ]
    },
    "play": {
      "enter": [
        {
          "set": "myAnswer",
          "to": "-1"
        },
        {
          "set": "myAnswerRound",
          "to": "-2"
        }
      ],
      "tick": [
        {
          "if": "sessionPhase === 'lobby'",
          "then": [
            {
              "go": "lobby"
            }
          ]
        },
        {
          "if": "sessionPhase === 'countdown'",
          "then": [
            {
              "go": "countdown"
            }
          ]
        },
        {
          "if": "sessionPhase === 'result'",
          "then": [
            {
              "go": "result"
            }
          ]
        }
      ]
    },
    "result": {
      "tick": [
        {
          "if": "sessionPhase === 'lobby'",
          "then": [
            {
              "go": "lobby"
            }
          ]
        },
        {
          "if": "sessionPhase === 'countdown'",
          "then": [
            {
              "go": "countdown"
            }
          ]
        },
        {
          "if": "sessionPhase === 'play'",
          "then": [
            {
              "go": "play"
            }
          ]
        }
      ]
    }
  },
  "view": {
    "box": "free",
    "children": [
      {
        "id": "bg",
        "box": "free",
        "width": 390,
        "height": 844,
        "x": 0,
        "y": 0,
        "fill": "#0b0c0e"
      },
      {
        "id": "lobbyScreen",
        "box": "column",
        "width": 390,
        "height": 844,
        "x": 0,
        "y": 0,
        "gap": 10,
        "pad": [
          59,
          16,
          34,
          16
        ],
        "show": "phase == 'lobby'",
        "children": [
          {
            "id": "navL",
            "use": "NavBar",
            "props": {
              "title": "스피드 퀴즈",
              "subtitle": "대기실"
            }
          },
          {
            "id": "lobbyCard",
            "box": "column",
            "width": 358,
            "height": 250,
            "grow": 1,
            "gap": 10,
            "pad": 18,
            "align": "center",
            "justify": "center",
            "fill": "#16181c",
            "children": [
              {
                "id": "lobbyEmoji",
                "text": "🧠",
                "size": 48,
                "align": "center"
              },
              {
                "id": "lobbyCount",
                "text": "{phase == 'lobby' ? (('참가자 ' + (roster.length) + '명')) : '참가자 1명'}",
                "width": 320,
                "size": 26,
                "font": "display",
                "color": "#d9ff00",
                "align": "center"
              },
              {
                "id": "lobbyNames",
                "text": "{phase == 'lobby' ? (roster.length > 0 ? roster.join(' · ') : '입장 중…') : ''}",
                "width": 320,
                "size": 15,
                "weight": 600,
                "color": "#9aa3af",
                "align": "center"
              }
            ]
          },
          {
            "id": "lobbyHint",
            "text": "같은 문제를 동시에! 빠르고 정확할수록 고득점 · 6문제 라이브 퀴즈쇼",
            "width": 340,
            "size": 14,
            "weight": 500,
            "color": "#9aa3af",
            "align": "center"
          },
          {
            "id": "lobbySpacer",
            "box": "free",
            "width": "fill",
            "height": 1
          },
          {
            "id": "startBtn",
            "use": "PrimaryButton",
            "props": {
              "label": "시작하기 🚀"
            },
            "onTap": [
              {
                "if": "phase == 'lobby'",
                "then": [
                  {
                    "set": "myAnswer",
                    "to": "-1"
                  },
                  {
                    "emit": "start",
                    "payload": {
                      "game": "trivia",
                      "quiz": true,
                      "rounds": 6,
                      "answerMs": 9000,
                      "revealMs": 3000
                    }
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "id": "countdownScreen",
        "box": "column",
        "width": 390,
        "height": 844,
        "x": 0,
        "y": 0,
        "gap": 10,
        "pad": [
          59,
          16,
          34,
          16
        ],
        "show": "phase == 'countdown'",
        "children": [
          {
            "id": "navC",
            "use": "NavBar",
            "props": {
              "title": "스피드 퀴즈",
              "subtitle": "곧 시작!"
            }
          },
          {
            "id": "cdCard",
            "box": "column",
            "width": "fill",
            "height": 420,
            "gap": 8,
            "pad": 18,
            "align": "center",
            "justify": "center",
            "fill": "#16181c",
            "children": [
              {
                "id": "cdNum",
                "text": "{phase == 'countdown' ? (sessionCountdown > 0 ? ('' + (sessionCountdown)) : 'GO!') : '3'}",
                "width": 320,
                "size": 140,
                "font": "display",
                "color": "#d9ff00",
                "align": "center"
              },
              {
                "id": "cdLabel",
                "text": "{phase == 'countdown' ? (sessionCountdown > 0 ? '준비…' : '퀴즈!') : '준비…'}",
                "width": 320,
                "size": 20,
                "weight": 700,
                "color": "#ffffff",
                "align": "center"
              }
            ]
          }
        ]
      },
      {
        "id": "playScreen",
        "box": "column",
        "width": 390,
        "height": 844,
        "x": 0,
        "y": 0,
        "gap": 10,
        "pad": [
          59,
          16,
          34,
          16
        ],
        "show": "phase == 'play'",
        "children": [
          {
            "id": "navP",
            "use": "NavBar",
            "props": {
              "title": "스피드 퀴즈",
              "subtitle": "퀴즈!"
            }
          },
          {
            "id": "roundLabel",
            "text": "{phase == 'play' ? (('' + (roundNum) + ' / ' + (roundTotal))) : '1 / 6'}",
            "width": 340,
            "size": 14,
            "weight": 700,
            "color": "#9aa3af",
            "align": "center"
          },
          {
            "id": "qText",
            "text": "{phase == 'play' ? (roundContent.q || '') : ''}",
            "width": 350,
            "size": 22,
            "font": "display",
            "color": "#ffffff",
            "align": "center"
          },
          {
            "id": "statusText",
            "text": "{phase == 'play' ? (roundAnswer < 0 ? '⏱ 정답을 빠르게!' : ((myAnswerRound === roundIdx && myAnswer === roundAnswer) ? '정답! 🎉' : (myAnswerRound === roundIdx ? '땡! 😢' : '시간 초과 ⌛'))) : '⏱ 정답을 빠르게!'}",
            "width": 340,
            "size": 15,
            "weight": 700,
            "color": "{phase == 'play' ? (roundAnswer < 0 ? '#d9ff00' : ((myAnswerRound === roundIdx && myAnswer === roundAnswer) ? '#22c55e' : '#FF5A5F')) : '#d9ff00'}",
            "align": "center"
          },
          {
            "id": "tile0",
            "box": "row",
            "width": "fill",
            "pad": 12,
            "align": "center",
            "justify": "center",
            "fill": "{phase == 'play' ? (roundAnswer >= 0 ? (0 === roundAnswer ? '#18351f' : ((myAnswer === 0 && myAnswerRound === roundIdx) ? '#3a171a' : '#16181c')) : ((myAnswer === 0 && myAnswerRound === roundIdx) ? '#2a3a10' : '#1e2127')) : '#1e2127'}",
            "onTap": [
              {
                "if": "phase == 'play'",
                "then": [
                  {
                    "set": "myAnswer",
                    "to": "0"
                  },
                  {
                    "set": "myAnswerRound",
                    "to": "roundIdx"
                  },
                  {
                    "emit": "answer",
                    "payload": {
                      "option": 0
                    }
                  }
                ]
              }
            ],
            "children": [
              {
                "id": "tile0Txt",
                "text": "{phase == 'play' ? ((roundContent.options && roundContent.options[0]) || '') : ''}",
                "width": 320,
                "size": 20,
                "weight": 800,
                "color": "#ffffff",
                "align": "center"
              }
            ]
          },
          {
            "id": "tile1",
            "box": "row",
            "width": "fill",
            "pad": 12,
            "align": "center",
            "justify": "center",
            "fill": "{phase == 'play' ? (roundAnswer >= 0 ? (1 === roundAnswer ? '#18351f' : ((myAnswer === 1 && myAnswerRound === roundIdx) ? '#3a171a' : '#16181c')) : ((myAnswer === 1 && myAnswerRound === roundIdx) ? '#2a3a10' : '#1e2127')) : '#1e2127'}",
            "onTap": [
              {
                "if": "phase == 'play'",
                "then": [
                  {
                    "set": "myAnswer",
                    "to": "1"
                  },
                  {
                    "set": "myAnswerRound",
                    "to": "roundIdx"
                  },
                  {
                    "emit": "answer",
                    "payload": {
                      "option": 1
                    }
                  }
                ]
              }
            ],
            "children": [
              {
                "id": "tile1Txt",
                "text": "{phase == 'play' ? ((roundContent.options && roundContent.options[1]) || '') : ''}",
                "width": 320,
                "size": 20,
                "weight": 800,
                "color": "#ffffff",
                "align": "center"
              }
            ]
          },
          {
            "id": "tile2",
            "box": "row",
            "width": "fill",
            "pad": 12,
            "align": "center",
            "justify": "center",
            "fill": "{phase == 'play' ? (roundAnswer >= 0 ? (2 === roundAnswer ? '#18351f' : ((myAnswer === 2 && myAnswerRound === roundIdx) ? '#3a171a' : '#16181c')) : ((myAnswer === 2 && myAnswerRound === roundIdx) ? '#2a3a10' : '#1e2127')) : '#1e2127'}",
            "onTap": [
              {
                "if": "phase == 'play'",
                "then": [
                  {
                    "set": "myAnswer",
                    "to": "2"
                  },
                  {
                    "set": "myAnswerRound",
                    "to": "roundIdx"
                  },
                  {
                    "emit": "answer",
                    "payload": {
                      "option": 2
                    }
                  }
                ]
              }
            ],
            "children": [
              {
                "id": "tile2Txt",
                "text": "{phase == 'play' ? ((roundContent.options && roundContent.options[2]) || '') : ''}",
                "width": 320,
                "size": 20,
                "weight": 800,
                "color": "#ffffff",
                "align": "center"
              }
            ]
          },
          {
            "id": "tile3",
            "box": "row",
            "width": "fill",
            "pad": 12,
            "align": "center",
            "justify": "center",
            "fill": "{phase == 'play' ? (roundAnswer >= 0 ? (3 === roundAnswer ? '#18351f' : ((myAnswer === 3 && myAnswerRound === roundIdx) ? '#3a171a' : '#16181c')) : ((myAnswer === 3 && myAnswerRound === roundIdx) ? '#2a3a10' : '#1e2127')) : '#1e2127'}",
            "onTap": [
              {
                "if": "phase == 'play'",
                "then": [
                  {
                    "set": "myAnswer",
                    "to": "3"
                  },
                  {
                    "set": "myAnswerRound",
                    "to": "roundIdx"
                  },
                  {
                    "emit": "answer",
                    "payload": {
                      "option": 3
                    }
                  }
                ]
              }
            ],
            "children": [
              {
                "id": "tile3Txt",
                "text": "{phase == 'play' ? ((roundContent.options && roundContent.options[3]) || '') : ''}",
                "width": 320,
                "size": 20,
                "weight": 800,
                "color": "#ffffff",
                "align": "center"
              }
            ]
          }
        ]
      },
      {
        "id": "resultScreen",
        "box": "column",
        "width": 390,
        "height": 844,
        "x": 0,
        "y": 0,
        "gap": 12,
        "pad": [
          59,
          16,
          34,
          16
        ],
        "show": "phase == 'result'",
        "children": [
          {
            "id": "resHead",
            "box": "column",
            "width": 290,
            "height": 88,
            "gap": 4,
            "children": [
              {
                "id": "resKicker",
                "text": "{resultView.kicker || '스피드 퀴즈 · 결과'}",
                "size": 14,
                "weight": 700,
                "color": "#9aa3af",
                "lines": 1
              },
              {
                "id": "resTitle",
                "text": "{resultView.headline || '결과'}",
                "size": 24,
                "font": "display",
                "color": "#ffffff",
                "lines": 2
              }
            ]
          },
          {
            "id": "resMine",
            "text": "{resultView.mine}",
            "show": "resultView.mine !== ''",
            "size": 15,
            "weight": 700,
            "color": "#ffffff",
            "lines": 1
          },
          {
            "id": "resBody",
            "box": "column",
            "height": 1,
            "grow": 1,
            "scroll": true,
            "gap": 12,
            "children": [
              {
                "id": "rankList",
                "box": "column",
                "gap": 4,
                "show": "resultView.mode == 'rank'",
                "each": "resultView.ranks",
                "children": [
                  {
                    "id": "rankRow",
                    "box": "row",
                    "height": 48,
                    "pad": [
                      0,
                      12
                    ],
                    "gap": 8,
                    "align": "center",
                    "fill": "{item.top ? '#d9ff00' : '#16181c'}",
                    "stroke": {
                      "color": "{item.me ? '#ffffff' : (item.top ? '#d9ff00' : '#16181c')}",
                      "width": 2
                    },
                    "children": [
                      {
                        "id": "rkRank",
                        "text": "{item.rankLabel}",
                        "width": 60,
                        "size": 15,
                        "weight": 800,
                        "color": "{item.top ? '#0b0c0e' : '#9aa3af'}",
                        "lines": 1
                      },
                      {
                        "id": "rkNick",
                        "text": "{item.nick}",
                        "width": 146,
                        "size": 16,
                        "weight": 700,
                        "color": "{item.top ? '#0b0c0e' : '#ffffff'}",
                        "lines": 1
                      },
                      {
                        "id": "rkLeft",
                        "text": "나감",
                        "show": "item.left",
                        "width": 28,
                        "size": 13,
                        "weight": 700,
                        "color": "{item.top ? '#0b0c0e' : '#9aa3af'}",
                        "lines": 1
                      },
                      {
                        "id": "rkScore",
                        "text": "{item.scoreLabel}",
                        "width": "fill",
                        "size": 16,
                        "weight": 800,
                        "color": "{item.top ? '#0b0c0e' : '#ffffff'}",
                        "align": "right",
                        "lines": 1
                      }
                    ]
                  }
                ]
              },
              {
                "id": "duoCard",
                "box": "column",
                "show": "resultView.mode == 'duo'",
                "pad": [
                  24,
                  16
                ],
                "gap": 8,
                "align": "center",
                "fill": "#16181c",
                "children": [
                  {
                    "id": "duoScore",
                    "text": "{resultView.duo.score}",
                    "size": 64,
                    "font": "display",
                    "color": "#d9ff00",
                    "align": "center",
                    "lines": 1
                  },
                  {
                    "id": "duoLine",
                    "text": "{resultView.duo.line}",
                    "width": 326,
                    "size": 18,
                    "weight": 700,
                    "color": "#ffffff",
                    "align": "center",
                    "lines": 2
                  },
                  {
                    "id": "duoTier",
                    "text": "{resultView.duo.tier}",
                    "show": "resultView.duo.tier !== ''",
                    "width": 326,
                    "size": 28,
                    "font": "display",
                    "color": "#ffffff",
                    "align": "center",
                    "lines": 1
                  }
                ]
              },
              {
                "id": "emptyCard",
                "box": "column",
                "show": "resultView.mode == 'empty'",
                "pad": 24,
                "align": "center",
                "fill": "#16181c",
                "children": [
                  {
                    "id": "emptyText",
                    "text": "{resultView.emptyText}",
                    "width": 310,
                    "size": 16,
                    "weight": 600,
                    "color": "#9aa3af",
                    "align": "center",
                    "lines": 2
                  }
                ]
              },
              {
                "id": "fallbackList",
                "box": "column",
                "gap": 4,
                "show": "resultView.mode == ''",
                "each": "raceBoard",
                "children": [
                  {
                    "id": "fbRow",
                    "text": "{index + 1}. {item.nick} · {item.score}점",
                    "size": 16,
                    "weight": 700,
                    "color": "#ffffff",
                    "lines": 1
                  }
                ]
              },
              {
                "id": "revealTitle",
                "text": "문제별 정답",
                "show": "resultView.questions.length > 0",
                "size": 15,
                "weight": 700,
                "color": "#9aa3af"
              },
              {
                "id": "revealList",
                "box": "column",
                "gap": 8,
                "each": "resultView.questions",
                "children": [
                  {
                    "id": "rvCard",
                    "box": "column",
                    "pad": 12,
                    "gap": 8,
                    "fill": "#16181c",
                    "children": [
                      {
                        "id": "rvQ",
                        "text": "Q{item.n}. {item.q}",
                        "size": 16,
                        "weight": 700,
                        "color": "#ffffff",
                        "lines": 3
                      },
                      {
                        "id": "rvAns",
                        "text": "정답 · {item.answer}",
                        "size": 15,
                        "weight": 700,
                        "color": "#22c55e",
                        "lines": 2
                      },
                      {
                        "id": "rvSum",
                        "text": "{item.summary}",
                        "size": 13,
                        "weight": 600,
                        "color": "#9aa3af",
                        "lines": 1
                      },
                      {
                        "id": "rvChips",
                        "box": "grid",
                        "columns": 2,
                        "gap": 4,
                        "show": "item.chips.length > 0",
                        "each": "item.chips",
                        "children": [
                          {
                            "id": "rvChip",
                            "box": "column",
                            "pad": [
                              4,
                              8
                            ],
                            "fill": "{item.state == 'ok' ? '#18351f' : (item.state == 'bad' ? '#3a171a' : '#1e2127')}",
                            "children": [
                              {
                                "id": "rvChipNick",
                                "text": "{item.nick}",
                                "size": 14,
                                "weight": 700,
                                "color": "#ffffff",
                                "lines": 1
                              },
                              {
                                "id": "rvChipPick",
                                "text": "{item.state == 'ok' ? '✓ ' : ''}{item.pick}",
                                "size": 12,
                                "weight": 500,
