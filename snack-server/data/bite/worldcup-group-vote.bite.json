{
  "bite": 1,
  "meta": {
    "name": "야식 월드컵 투표",
    "multi": true
  },
  "frame": [
    390,
    844
  ],
  "vars": {
    "sessionPhase": "lobby",
    "sessionCountdown": 0,
    "roster": [],
    "votesByOption": {
      "o0": 0,
      "o1": 0
    },
    "roundContent": {
      "a": null,
      "b": null
    },
    "bracketLabel": "",
    "matchWinner": -1,
    "champion": null,
    "roomMode": "",
    "roomPin": false,
    "hostNick": "",
    "iAmHost": false,
    "autoStartIn": 0
  },
  "room": {
    "start": {
      "game": "worldcup",
      "bracket": true,
      "matchupMs": 8000
    },
    "autoStartMs": 10000
  },
  "components": {
    "NavBar": {
      "props": {
        "title": "",
        "subtitle": ""
      },
      "view": {
        "id": "root",
        "box": "column",
        "height": "hug",
        "gap": 2,
        "children": [
          {
            "id": "title",
            "text": "{props.title}",
            "size": 28,
            "weight": 700,
            "color": "#ffffff"
          },
          {
            "id": "sub",
            "text": "{props.subtitle}",
            "size": 15,
            "weight": 500,
            "color": "#9aa3af"
          }
        ]
      }
    },
    "GhostButton": {
      "props": {
        "label": "취소"
      },
      "view": {
        "id": "root",
        "box": "row",
        "height": 50,
        "align": "center",
        "justify": "center",
        "fill": "#1e2127",
        "stroke": {
          "color": "#2a2d33",
          "width": 1
        },
        "children": [
          {
            "id": "lbl",
            "text": "{props.label}",
            "size": 17,
            "weight": 600,
            "color": "#ffffff"
          }
        ]
      }
    },
    "StatCard": {
      "props": {
        "label": "",
        "value": "0"
      },
      "view": {
        "id": "root",
        "box": "column",
        "height": "hug",
        "gap": 6,
        "pad": 20,
        "fill": "#16181c",
        "children": [
          {
            "id": "lbl",
            "text": "{props.label}",
            "size": 14,
            "weight": 600,
            "color": "#9aa3af"
          },
          {
            "id": "val",
            "text": "{props.value}",
            "size": 40,
            "weight": 700,
            "color": "#ffffff"
          }
        ]
      }
    },
    "PrimaryButton": {
      "props": {
        "label": "확인"
      },
      "view": {
        "id": "root",
        "box": "row",
        "height": 56,
        "align": "center",
        "justify": "center",
        "fill": "#d9ff00",
        "children": [
          {
            "id": "lbl",
            "text": "{props.label}",
            "size": 17,
            "weight": 800,
            "color": "#0b0c0e"
          }
        ]
      }
    }
  },
  "start": "lobby",
  "phases": {
    "lobby": {
      "tick": [
        {
          "if": "sessionPhase === 'countdown'",
          "then": [
            {
              "go": "countdown"
            }
          ]
        },
        {
          "if": "sessionPhase === 'play'",
          "then": [
            {
              "go": "play"
            }
          ]
        },
        {
          "if": "sessionPhase === 'result'",
          "then": [
            {
              "go": "result"
            }
          ]
        }
      ]
    },
    "countdown": {
      "tick": [
        {
          "if": "sessionPhase === 'lobby'",
          "then": [
            {
              "go": "lobby"
            }
          ]
        },
        {
          "if": "sessionPhase === 'play'",
          "then": [
            {
              "go": "play"
            }
          ]
        },
        {
          "if": "sessionPhase === 'result'",
          "then": [
            {
              "go": "result"
            }
          ]
        }
      ]
    },
    "play": {
      "tick": [
        {
          "if": "sessionPhase === 'lobby'",
          "then": [
            {
              "go": "lobby"
            }
          ]
        },
        {
          "if": "sessionPhase === 'countdown'",
          "then": [
            {
              "go": "countdown"
            }
          ]
        },
        {
          "if": "sessionPhase === 'result'",
          "then": [
            {
              "go": "result"
            }
          ]
        }
      ]
    },
    "result": {
      "tick": [
        {
          "if": "sessionPhase === 'lobby'",
          "then": [
            {
              "go": "lobby"
            }
          ]
        },
        {
          "if": "sessionPhase === 'countdown'",
          "then": [
            {
              "go": "countdown"
            }
          ]
        },
        {
          "if": "sessionPhase === 'play'",
          "then": [
            {
              "go": "play"
            }
          ]
        }
      ]
    }
  },
  "view": {
    "box": "free",
    "children": [
      {
        "id": "bg",
        "box": "free",
        "width": 390,
        "height": 844,
        "x": 0,
        "y": 0,
        "fill": "#0b0c0e"
      },
      {
        "id": "lobbyScreen",
        "box": "column",
        "width": 390,
        "height": 844,
        "x": 0,
        "y": 0,
        "gap": 10,
        "pad": [
          59,
          16,
          34,
          16
        ],
        "show": "phase == 'lobby'",
        "children": [
          {
            "id": "navL",
            "use": "NavBar",
            "props": {
              "title": "야식 월드컵 투표",
              "subtitle": "{roomMode == 'auto' ? '🌐 누구나 함께하는 방 · 2명 모이면 시작' : roomMode == 'host' ? ((roomPin ? '🤝🔒' : '🤝') + ' 초대받은 친구만 들어오는 방 · 방장이 시작') : '대기실'}"
            }
          },
          {
            "id": "lobbyCard",
            "box": "column",
            "width": 358,
            "height": 250,
            "gap": 10,
            "pad": 18,
            "align": "center",
            "justify": "center",
            "fill": "#16181c",
            "children": [
              {
                "id": "lobbyEmoji",
                "text": "🏆",
                "size": 48,
                "align": "center"
              },
              {
                "id": "lobbyCount",
                "text": "{phase == 'lobby' ? (('참가자 ' + (roster.length) + '명')) : '참가자 1명'}",
                "width": 320,
                "size": 26,
                "weight": 700,
                "color": "#d9ff00",
                "align": "center"
              },
              {
                "id": "lobbyNames",
                "text": "{phase == 'lobby' ? (roster.length > 0 ? roster.join(' · ') : '입장 중…') : ''}",
                "width": 320,
                "size": 15,
                "weight": 600,
                "color": "#9aa3af",
                "align": "center"
              }
            ]
          },
          {
            "id": "lobbyHint",
            "text": "16강부터 결승까지, 매 대결마다 다 같이 한 표! 우리 방의 야식 챔피언을 뽑아요",
            "width": 340,
            "size": 14,
            "weight": 500,
            "color": "#9aa3af",
            "align": "center"
          },
          {
            "id": "lobbySpacer",
            "box": "free",
            "width": "fill",
            "height": 1,
            "grow": 1
          },
          {
            "id": "startBtn",
            "use": "PrimaryButton",
            "props": {
              "label": "시작하기 🚀"
            },
            "onTap": [
              {
                "if": "phase == 'lobby' && (roomMode == '' || (roomMode == 'host' && iAmHost) || (roomMode == 'auto' && autoStartIn <= 0 && roster.length >= 2))",
                "then": [
                  {
                    "emit": "start",
                    "payload": {
                      "game": "worldcup",
                      "bracket": true,
                      "matchupMs": 8000
                    }
                  }
                ]
              }
            ],
            "show": "(roomMode == '' || (roomMode == 'host' && iAmHost) || (roomMode == 'auto' && autoStartIn <= 0 && roster.length >= 2))"
          },
          {
            "id": "startWait",
            "box": "column",
            "width": "fill",
            "height": 56,
            "gap": 2,
            "align": "center",
            "justify": "center",
            "fill": "#16181c",
            "stroke": {
              "color": "#2a2d33",
              "width": 1
            },
            "show": "!(roomMode == '' || (roomMode == 'host' && iAmHost) || (roomMode == 'auto' && autoStartIn <= 0 && roster.length >= 2))",
            "children": [
              {
                "id": "startWaitMain",
                "text": "{roomMode == 'auto' ? (roster.length < 2 ? '한 명 더 오면 시작해요' : (autoStartIn + '초 뒤 시작 · ' + roster.length + '명')) : '방장이 시작하길 기다리는 중'}",
                "size": 16,
                "weight": 700,
                "color": "#d9ff00",
                "align": "center",
                "lines": 1
              },
              {
                "id": "startWaitSub",
                "text": "{roomMode == 'auto' ? (roster.length < 2 ? '링크를 친구에게 보내도 돼요' : '지금 들어온 사람 모두 같이 시작해요') : ('방장 · ' + hostNick)}",
                "size": 13,
                "weight": 600,
                "color": "#9aa3af",
                "align": "center",
                "lines": 1
              }
            ]
          }
        ]
      },
      {
        "id": "countdownScreen",
        "box": "column",
        "width": 390,
        "height": 844,
        "x": 0,
        "y": 0,
        "gap": 10,
        "pad": [
          59,
          16,
          34,
          16
        ],
        "show": "phase == 'countdown'",
        "children": [
          {
            "id": "navC",
            "use": "NavBar",
            "props": {
              "title": "야식 월드컵 투표",
              "subtitle": "곧 시작!"
            }
          },
          {
            "id": "cdCard",
            "box": "column",
            "width": "fill",
            "height": 420,
            "gap": 8,
            "pad": 18,
            "align": "center",
            "justify": "center",
            "fill": "#16181c",
            "children": [
              {
                "id": "cdNum",
                "text": "{phase == 'countdown' ? (sessionCountdown > 0 ? ('' + (sessionCountdown)) : 'GO!') : '3'}",
                "width": 320,
                "size": 140,
                "font": "display",
                "color": "#d9ff00",
                "align": "center"
              },
              {
                "id": "cdLabel",
                "text": "{phase == 'countdown' ? (sessionCountdown > 0 ? '준비…' : '대결!') : '준비…'}",
                "width": 320,
                "size": 20,
                "weight": 700,
                "color": "#ffffff",
                "align": "center"
              }
            ]
          }
        ]
      },
      {
        "id": "playScreen",
        "box": "column",
        "width": 390,
        "height": 844,
        "x": 0,
        "y": 0,
        "gap": 10,
        "pad": [
          59,
          16,
          34,
          16
        ],
        "show": "phase == 'play'",
        "children": [
          {
            "id": "navP",
            "use": "NavBar",
            "props": {
              "title": "야식 월드컵 투표",
              "subtitle": "월드컵!"
            }
          },
          {
            "id": "bracketText",
            "text": "{phase == 'play' ? (bracketLabel || '') : '16강'}",
            "width": 340,
            "size": 16,
            "weight": 800,
            "color": "#d9ff00",
            "align": "center"
          },
          {
            "id": "cardA",
            "box": "column",
            "width": "fill",
            "gap": 4,
            "pad": 14,
            "align": "center",
            "justify": "center",
            "fill": "#16181c",
            "stroke": {
              "color": "{phase == 'play' ? (matchWinner === 0 ? '#d9ff00' : '#16181c') : '#16181c'}",
              "width": 4
            },
            "onTap": [
              {
                "if": "phase == 'play'",
                "then": [
                  {
                    "emit": "vote",
                    "payload": {
                      "option": "o0"
                    }
                  }
                ]
              }
            ],
            "children": [
              {
                "id": "cardAEmoji",
                "text": "{phase == 'play' ? (roundContent.a ? roundContent.a.emoji : '') : ''}",
                "size": 84,
                "align": "center"
              },
              {
                "id": "cardAName",
                "text": "{phase == 'play' ? (roundContent.a ? roundContent.a.name : '') : ''}",
                "width": 320,
                "size": 27,
                "weight": 700,
                "color": "#ffffff",
                "align": "center"
              },
              {
                "id": "cardAPct",
                "text": "{phase == 'play' ? (((votesByOption.o0||0)+(votesByOption.o1||0)) === 0 ? '0%' : ('' + (round((votesByOption.o0||0)/((votesByOption.o0||0)+(votesByOption.o1||0))*100)) + '%')) : '0%'}",
                "size": 26,
                "font": "display",
                "color": "#d9ff00",
                "align": "center"
              },
              {
                "id": "cardAWin",
                "text": "👑 승!",
                "size": 18,
                "weight": 800,
                "color": "#d9ff00",
                "align": "center",
                "show": "phase == 'play' ? (matchWinner === 0) : false"
              }
            ]
          },
          {
            "id": "vsLabel",
            "text": "VS",
            "width": 340,
            "size": 18,
            "weight": 800,
            "color": "#4DA3FF",
            "align": "center"
          },
          {
            "id": "cardB",
            "box": "column",
            "width": "fill",
            "gap": 4,
            "pad": 14,
            "align": "center",
            "justify": "center",
            "fill": "#16181c",
            "stroke": {
              "color": "{phase == 'play' ? (matchWinner === 1 ? '#4DA3FF' : '#16181c') : '#16181c'}",
              "width": 4
            },
            "onTap": [
              {
                "if": "phase == 'play'",
                "then": [
                  {
                    "emit": "vote",
                    "payload": {
                      "option": "o1"
                    }
                  }
                ]
              }
            ],
            "children": [
              {
                "id": "cardBEmoji",
                "text": "{phase == 'play' ? (roundContent.b ? roundContent.b.emoji : '') : ''}",
                "size": 84,
                "align": "center"
              },
              {
                "id": "cardBName",
                "text": "{phase == 'play' ? (roundContent.b ? roundContent.b.name : '') : ''}",
                "width": 320,
                "size": 27,
                "weight": 700,
                "color": "#ffffff",
                "align": "center"
              },
              {
                "id": "cardBPct",
                "text": "{phase == 'play' ? (((votesByOption.o0||0)+(votesByOption.o1||0)) === 0 ? '0%' : ('' + (round((votesByOption.o1||0)/((votesByOption.o0||0)+(votesByOption.o1||0))*100)) + '%')) : '0%'}",
                "size": 26,
                "font": "display",
                "color": "#4DA3FF",
                "align": "center"
              },
              {
                "id": "cardBWin",
                "text": "👑 승!",
                "size": 18,
                "weight": 800,
                "color": "#4DA3FF",
                "align": "center",
                "show": "phase == 'play' ? (matchWinner === 1) : false"
              }
            ]
          }
        ]
      },
      {
        "id": "resultScreen",
        "box": "column",
        "width": 390,
        "height": 844,
        "x": 0,
        "y": 0,
        "gap": 10,
        "pad": [
          59,
          16,
          34,
          16
        ],
        "show": "phase == 'result'",
        "children": [
          {
            "id": "navR",
            "use": "NavBar",
            "props": {
              "title": "야식 월드컵 투표",
              "subtitle": "우승"
            }
          },
          {
            "id": "champCard",
            "box": "column",
            "width": 358,
            "height": 380,
            "gap": 12,
            "pad": 18,
            "align": "center",
            "justify": "center",
            "fill": "#16181c",
            "children": [
              {
                "id": "champEmoji",
                "text": "{phase == 'result' ? (champion ? champion.emoji : '🏆') : '🏆'}",
                "size": 130,
                "align": "center"
              },
              {
                "id": "champTitle",
                "text": "{phase == 'result' ? (champion ? ('🏆 ' + (champion.name) + ' 우승!') : '결과') : ''}",
                "width": 320,
                "size": 28,
                "weight": 700,
                "color": "#d9ff00",
                "align": "center"
              }
            ]
          },
          {
            "id": "resSpacer",
            "box": "free",
            "width": "fill",
            "height": 1,
            "grow": 1
          },
          {
            "id": "againBtn",
            "use": "PrimaryButton",
            "props": {
              "label": "{roomMode == 'auto' ? '한 판 더 🔁' : '다시 하기 🔁'}"
            },
            "onTap": [
              {
                "if": "phase == 'result' && (roomMode == '' || roomMode == 'auto' || (roomMode == 'host' && iAmHost))",
                "then": [
                  {
                    "emit": "start",
                    "payload": {
                      "game": "worldcup",
                      "bracket": true,
                      "matchupMs": 8000
                    }
                  }
                ]
              }
            ],
            "show": "(roomMode == '' || roomMode == 'auto' || (roomMode == 'host' && iAmHost))"
          },
          {
            "id": "againWait",
            "box": "column",
            "width": "fill",
            "height": 56,
            "gap": 2,
            "align": "center",
            "justify": "center",
            "fill": "#16181c",
            "stroke": {
              "color": "#2a2d33",
              "width": 1
            },
            "show": "!(roomMode == '' || roomMode == 'auto' || (roomMode == 'host' && iAmHost))",
            "children": [
              {
                "id": "againWaitMain",
                "text": "방장이 다시 시작하길 기다리는 중",
                "size": 16,
                "weight": 700,
                "color": "#d9ff00",
                "align": "center",
                "lines": 1
              },
              {
                "id": "againWaitSub",
                "text": "{'방장 · ' + hostNick}",
                "size": 13,
                "weight": 600,
                "color": "#9aa3af",
                "align": "center",
                "lines": 1
              }
            ]
          }
        ]
      }
    ]
  }
}
