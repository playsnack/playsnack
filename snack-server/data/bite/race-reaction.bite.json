{
  "bite": 1,
  "meta": {
    "name": "반응속도 대결"
  },
  "frame": [
    390,
    844
  ],
  "vars": {
    "score": 0,
    "reactionMs": 0,
    "startedAt": 0,
    "targetAt": 0,
    "duration": 3000,
    "leaderboard": []
  },
  "components": {
    "NavBar": {
      "props": {
        "title": "",
        "subtitle": ""
      },
      "view": {
        "id": "root",
        "box": "column",
        "height": "hug",
        "gap": 2,
        "children": [
          {
            "id": "title",
            "text": "{props.title}",
            "size": 28,
            "font": "display",
            "color": "#ffffff"
          },
          {
            "id": "sub",
            "text": "{props.subtitle}",
            "size": 15,
            "weight": 500,
            "color": "#9aa3af"
          }
        ]
      }
    },
    "Button": {
      "props": {
        "label": "확인"
      },
      "view": {
        "id": "root",
        "box": "row",
        "height": 50,
        "align": "center",
        "justify": "center",
        "fill": "#d9ff00",
        "shadow": {
          "x": 0,
          "y": 4,
          "blur": 16,
          "color": "#d9ff0040"
        },
        "children": [
          {
            "id": "lbl",
            "text": "{props.label}",
            "size": 17,
            "weight": 700,
            "color": "#0b0c0e"
          }
        ]
      }
    },
    "GhostButton": {
      "props": {
        "label": "취소"
      },
      "view": {
        "id": "root",
        "box": "row",
        "height": 50,
        "align": "center",
        "justify": "center",
        "fill": "#1e2127",
        "stroke": {
          "color": "#2a2d33",
          "width": 1
        },
        "children": [
          {
            "id": "lbl",
            "text": "{props.label}",
            "size": 17,
            "weight": 600,
            "color": "#ffffff"
          }
        ]
      }
    },
    "StatCard": {
      "props": {
        "label": "",
        "value": "0"
      },
      "view": {
        "id": "root",
        "box": "column",
        "height": "hug",
        "gap": 6,
        "pad": 20,
        "fill": "#16181c",
        "children": [
          {
            "id": "lbl",
            "text": "{props.label}",
            "size": 14,
            "weight": 600,
            "color": "#9aa3af"
          },
          {
            "id": "val",
            "text": "{props.value}",
            "size": 40,
            "font": "display",
            "color": "#ffffff"
          }
        ]
      }
    },
    "Chip": {
      "props": {
        "label": ""
      },
      "view": {
        "id": "root",
        "box": "row",
        "width": "hug",
        "height": 30,
        "pad": [
          0,
          12
        ],
        "align": "center",
        "justify": "center",
        "fill": "#1e2127",
        "stroke": {
          "color": "#2a2d33",
          "width": 1
        },
        "children": [
          {
            "id": "lbl",
            "text": "{props.label}",
            "size": 13,
            "weight": 600,
            "color": "#9aa3af"
          }
        ]
      }
    }
  },
  "start": "ready",
  "phases": {
    "ready": {},
    "wait": {
      "tick": [
        {
          "if": "now >= targetAt",
          "then": [
            {
              "set": "startedAt",
              "to": "now"
            },
            {
              "go": "go"
            }
          ]
        }
      ]
    },
    "go": {
      "tick": [
        {
          "if": "now - startedAt >= duration",
          "then": [
            {
              "set": "reactionMs",
              "to": "3000"
            },
            {
              "set": "score",
              "to": "0"
            },
            {
              "emit": "score",
              "payload": {
                "score": "score"
              }
            },
            {
              "go": "result"
            }
          ]
        }
      ]
    },
    "result": {}
  },
  "view": {
    "box": "free",
    "children": [
      {
        "id": "bg",
        "box": "free",
        "width": 390,
        "height": 844,
        "x": 0,
        "y": 0,
        "fill": "#0b0c0e"
      },
      {
        "id": "readyScreen",
        "box": "column",
        "width": 390,
        "height": 844,
        "x": 0,
        "y": 0,
        "gap": 16,
        "pad": [
          59,
          16,
          34,
          16
        ],
        "show": "phase == 'ready'",
        "children": [
          {
            "id": "readyNav",
            "use": "NavBar",
            "props": {
              "title": "반응속도 대결",
              "subtitle": "초록빛이 켜지는 순간, 가장 빠르게 탭하세요."
            }
          },
          {
            "id": "readyHero",
            "box": "column",
            "height": "fill",
            "gap": 18,
            "pad": 20,
            "align": "center",
            "justify": "center",
            "fill": "#16181c",
            "shadow": {
              "x": 0,
              "y": 12,
              "blur": 24,
              "color": "#00000047"
            },
            "children": [
              {
                "id": "readyOrb",
                "box": "free",
                "width": 154,
                "height": 154,
                "fill": "#1e2127",
                "radius": "full",
                "stroke": {
                  "color": "#2a2d33",
                  "width": 2
                }
              },
              {
                "id": "readyTitle",
                "text": "기다렸다가 탭!",
                "size": 32,
                "font": "display",
                "color": "#ffffff",
                "align": "center"
              },
              {
                "id": "readyBody",
                "text": "시작하면 화면이 어두워집니다. 초록색으로 바뀌기 전에는 누르면 실격, 바뀐 뒤 최대한 빠르게 탭하면 점수가 제출돼요.",
                "width": 300,
                "size": 16,
                "weight": 500,
                "color": "#9aa3af",
                "align": "center"
              },
              {
                "id": "readyChipRow",
                "box": "row",
                "height": "hug",
                "gap": 8,
                "justify": "center",
                "children": [
                  {
                    "id": "chipFast",
                    "use": "Chip",
                    "props": {
                      "label": "빠를수록 고득점"
                    }
                  },
                  {
                    "id": "chipLive",
                    "use": "Chip",
                    "props": {
                      "label": "실시간 랭킹"
                    }
                  }
                ]
              }
            ]
          },
          {
            "id": "startBtn",
            "use": "Button",
            "props": {
              "label": "시작"
            },
            "onTap": [
              {
                "if": "phase == 'ready'",
                "then": [
                  {
                    "set": "score",
                    "to": "0"
                  },
                  {
                    "set": "reactionMs",
                    "to": "0"
                  },
                  {
                    "set": "startedAt",
                    "to": "now"
                  },
                  {
                    "set": "targetAt",
                    "to": "now + 1200 + round(random() * 2200)"
                  },
                  {
                    "go": "wait"
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "id": "waitScreen",
        "box": "column",
        "width": 390,
        "height": 844,
        "x": 0,
        "y": 0,
        "gap": 16,
        "pad": [
          59,
          16,
          34,
          16
        ],
        "show": "phase == 'wait'",
        "children": [
          {
            "id": "waitNav",
            "use": "NavBar",
            "props": {
              "title": "아직 누르지 마세요",
              "subtitle": "초록색 신호를 기다리세요."
            }
          },
          {
            "id": "waitPad",
            "box": "column",
            "height": "fill",
            "gap": 18,
            "pad": 22,
            "align": "center",
            "justify": "center",
            "fill": "#16181c",
            "stroke": {
              "color": "#2a2d33",
              "width": 1
            },
            "onTap": [
              {
                "if": "phase == 'wait'",
                "then": [
                  {
                    "set": "reactionMs",
                    "to": "-1"
                  },
                  {
                    "set": "score",
                    "to": "0"
                  },
                  {
                    "emit": "score",
                    "payload": {
                      "score": "score"
                    }
                  },
                  {
                    "go": "result"
                  }
                ]
              }
            ],
            "children": [
              {
                "id": "waitCircle",
                "box": "free",
                "width": 188,
                "height": 188,
                "fill": "#2a2d33",
                "radius": "full"
              },
              {
                "id": "waitTitle",
                "text": "대기 중…",
                "size": 34,
                "font": "display",
                "color": "#ffffff",
                "align": "center"
              },
              {
                "id": "waitHint",
                "text": "초록으로 바뀌는 순간 화면을 탭하세요. 지금 누르면 0점 처리됩니다.",
                "width": 300,
                "size": 16,
                "weight": 500,
                "color": "#9aa3af",
                "align": "center"
              }
            ]
          },
          {
            "id": "waitGhost",
            "use": "GhostButton",
            "props": {
              "label": "집중하기"
            }
          }
        ]
      },
      {
        "id": "goScreen",
        "box": "column",
        "width": 390,
        "height": 844,
        "x": 0,
        "y": 0,
        "gap": 16,
        "pad": [
          59,
          16,
          34,
          16
        ],
        "show": "phase == 'go'",
        "children": [
          {
            "id": "goNav",
            "use": "NavBar",
            "props": {
              "title": "지금!",
              "subtitle": "최대한 빠르게 탭하세요."
            }
          },
          {
            "id": "goPad",
            "box": "column",
            "height": "fill",
            "gap": 14,
            "pad": 22,
            "align": "center",
            "justify": "center",
            "fill": "#d9ff00",
            "shadow": {
              "x": 0,
              "y": 10,
              "blur": 30,
              "color": "#d9ff0047"
            },
            "onTap": [
              {
                "if": "phase == 'go'",
                "then": [
                  {
                    "set": "reactionMs",
                    "to": "round(now - startedAt)"
                  },
                  {
                    "set": "score",
                    "to": "max(0, 1000 - round(now - startedAt))"
                  },
                  {
                    "emit": "score",
                    "payload": {
                      "score": "score"
                    }
                  },
                  {
                    "go": "result"
                  }
                ]
              }
            ],
            "children": [
              {
                "id": "goText",
                "text": "TAP!",
                "size": 58,
                "font": "display",
                "color": "#0b0c0e",
                "align": "center"
              },
              {
                "id": "goSub",
                "text": "반응 시간을 측정합니다",
                "size": 17,
                "weight": 700,
                "color": "#0b0c0e",
                "align": "center"
              },
              {
                "id": "goTimer",
                "text": "{phase == 'go' ? (('' + (max(0, round(now - startedAt))) + 'ms')) : '0ms'}",
                "size": 28,
                "font": "display",
                "color": "#0b0c0e",
                "align": "center"
              }
            ]
          },
          {
            "id": "goHint",
            "text": "3초 안에 탭하지 못하면 0점으로 제출돼요.",
            "size": 13,
            "weight": 500,
            "color": "#9aa3af",
            "align": "center"
          }
        ]
      },
      {
        "id": "resultScreen",
        "box": "column",
        "width": 390,
        "height": 844,
        "x": 0,
        "y": 0,
        "gap": 16,
        "pad": [
          59,
          16,
          34,
          16
        ],
        "show": "phase == 'result'",
        "children": [
          {
            "id": "resultNav",
            "use": "NavBar",
            "props": {
              "title": "결과",
              "subtitle": "실시간 최고 반응속도 순위"
            }
          },
          {
            "id": "resultStatsRow",
            "box": "row",
            "height": "hug",
            "gap": 12,
            "children": [
              {
                "id": "scoreCard",
                "use": "StatCard",
                "props": {
                  "label": "내 점수",
                  "value": "{phase == 'result' ? (('' + (score) + '점')) : '0점'}"
                },
                "width": "fill"
              },
              {
                "id": "reactionCard",
                "use": "StatCard",
                "props": {
                  "label": "반응시간",
                  "value": "{phase == 'result' ? (reactionMs < 0 ? '실격' : ('' + (reactionMs) + 'ms')) : '0ms'}"
                },
                "width": "fill"
              }
            ]
          },
          {
            "id": "rankCard",
            "box": "column",
            "height": "fill",
            "gap": 12,
            "pad": 16,
            "fill": "#16181c",
            "children": [
              {
                "id": "rankTitle",
                "text": "라이브 리더보드",
                "size": 20,
                "weight": 800,
                "color": "#ffffff"
              },
              {
                "id": "rankSub",
                "text": "서버에 제출된 최고 점수 TOP 10",
                "size": 13,
                "weight": 500,
                "color": "#9aa3af"
              },
              {
                "id": "leaderboardList",
                "box": "column",
                "gap": 8,
                "each": "leaderboard",
                "children": [
                  {
                    "box": "row",
                    "height": 48,
                    "gap": 10,
                    "pad": [
                      0,
                      14
                    ],
                    "align": "center",
                    "fill": "#1e2127",
                    "children": [
                      {
                        "text": "{index + 1}",
                        "width": 30,
                        "size": 15,
                        "weight": 800,
                        "color": "#d9ff00"
                      },
                      {
                        "text": "{index + 1}위 · {item}점",
                        "width": 250,
                        "size": 16,
                        "weight": 700,
                        "color": "#ffffff"
                      }
                    ]
                  }
                ]
              },
              {
                "id": "emptyRankHint",
                "text": "아직 도착한 기록이 없어요. 첫 기록을 남겨보세요!",
                "width": 326,
                "size": 14,
                "weight": 500,
                "color": "#9aa3af",
                "align": "center",
                "show": "phase == 'result' ? (leaderboard.length === 0) : true"
              }
            ]
          },
          {
            "id": "againBtn",
            "use": "Button",
            "props": {
              "label": "다시 도전"
            },
            "onTap": [
              {
                "if": "phase == 'result'",
                "then": [
                  {
                    "go": "ready"
                  }
                ]
              }
            ]
          }
        ]
      }
    ]
  }
}
