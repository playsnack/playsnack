  "start": "ready",
  "phases": {
    "ready": {},
    "play": {
      "tick": [
        {
          "if": "now - startedAt >= duration",
          "then": [
            {
              "emit": "score",
              "payload": {
                "score": "score"
              }
            },
            {
              "go": "result"
            }
          ]
        }
      ]
    },
    "result": {}
  },
  "view": {
    "box": "free",
