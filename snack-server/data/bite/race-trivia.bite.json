                  "accent": false
                },
                "onTap": [
                  {
                    "if": "phase == 'play'",
                    "then": [
                      {
                        "if": "questions[currentQ].a === 0",
                        "then": [
                          {
                            "set": "score",
                            "to": "score + 1"
                          }
                        ]
                      },
                      {
                        "set": "currentQ",
                        "to": "(currentQ + 1) % questions.length"
                      }
                    ]
                  }
                ]
              },
              {
                "id": "opt1",
