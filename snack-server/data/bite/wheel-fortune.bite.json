              },
              {
                "id": "resultSub",
                "text": "룰렛이 부드럽게 멈춘 칸이에요.",
                "size": 15,
                "weight": 500,
                "color": "#9aa3af",
                "align": "center"
              },
              {
                "id": "resultBadge",
                "box": "column",
                "height": 132,
                "gap": 4,
                "pad": 16,
                "align": "center",
                "justify": "center",
                "fill": "#d9ff00",
                "children": [
                  {
                    "id": "resultLabel",
                    "text": "{phase == 'result' ? (finalIndex === 4 || finalIndex === 7 ? '오늘의 벌칙' : '오늘의 보상') : '오늘의 보상'}",
                    "size": 14,
                    "weight": 800,
                    "color": "#0b0c0e",
                    "align": "center"
                  },
                  {
                    "id": "resultText",
                    "text": "{phase == 'result' ? (finalIndex === 0 ? '커피 쿠폰' : (finalIndex === 1 ? '칭찬 3번' : (finalIndex === 2 ? '간식 타임' : (finalIndex === 3 ? '스트레칭 5분' : (finalIndex === 4 ? '꽝! 다음 기회' : (finalIndex === 5 ? '물 한잔 미션' : (finalIndex === 6 ? '좋아하는 노래' : '귀여운 벌칙'))))))) : '커피 쿠폰'}",
                    "size": 30,
                    "weight": 700,
                    "color": "#0b0c0e",
                    "align": "center"
                  }
                ]
              },
              {
                "id": "resultNote",
                "text": "마음에 들지 않아도 한 번 더 돌리면 새로운 운이 찾아옵니다.",
                "size": 15,
                "weight": 500,
                "color": "#9aa3af",
                "align": "center"
              }
            ]
          },
          {
            "id": "againButton",
            "use": "Button",
            "props": {
              "label": "다시 돌리기"
            },
            "onTap": [
              {
                "if": "phase == 'result'",
                "then": [
                  {
                    "set": "finalIndex",
                    "to": "floor(random() * 8)"
                  },
                  {
                    "set": "finalAngle",
                    "to": "2160 - finalIndex * 45"
                  },
                  {
                    "set": "spinStartedAt",
                    "to": "now"
                  },
                  {
                    "go": "spinning"
                  }
                ]
              }
            ]
          }
        ]
      }
    ]
  }
}
