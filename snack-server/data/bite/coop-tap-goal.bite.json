{
  "bite": 1,
  "meta": {
    "name": "다 같이 게이지 채우기",
    "multi": true
  },
  "frame": [
    390,
    844
  ],
  "vars": {
    "sessionPhase": "lobby",
    "sessionCountdown": 0,
    "roster": [],
    "coopTotal": 0,
    "myTaps": 0,
    "sentTaps": 0,
    "sentAt": 0,
    "shownTotal": 0,
    "tapBatchMs": 250,
    "roomMode": "",
    "hostNick": "",
    "iAmHost": false,
    "autoStartIn": 0
  },
  "room": {
    "start": {
      "duration": 15000
    },
    "autoStartMs": 10000
  },
  "components": {
    "NavBar": {
      "props": {
        "title": "",
        "subtitle": ""
      },
      "view": {
        "id": "root",
        "box": "column",
        "height": "hug",
        "gap": 2,
        "children": [
          {
            "id": "title",
            "text": "{props.title}",
            "size": 28,
            "weight": 700,
            "color": "#ffffff"
          },
          {
            "id": "sub",
            "text": "{props.subtitle}",
            "size": 15,
            "weight": 500,
            "color": "#9aa3af"
          }
        ]
      }
    },
    "GhostButton": {
      "props": {
        "label": "취소"
      },
      "view": {
        "id": "root",
        "box": "row",
        "height": 50,
        "align": "center",
        "justify": "center",
        "fill": "#1e2127",
        "stroke": {
          "color": "#2a2d33",
          "width": 1
        },
        "children": [
          {
            "id": "lbl",
            "text": "{props.label}",
            "size": 17,
            "weight": 600,
            "color": "#ffffff"
          }
        ]
      }
    },
    "StatCard": {
      "props": {
        "label": "",
        "value": "0"
      },
      "view": {
        "id": "root",
        "box": "column",
        "height": "hug",
        "gap": 6,
        "pad": 20,
        "fill": "#16181c",
        "children": [
          {
            "id": "lbl",
            "text": "{props.label}",
            "size": 14,
            "weight": 600,
            "color": "#9aa3af"
          },
          {
            "id": "val",
            "text": "{props.value}",
            "size": 40,
            "weight": 700,
            "color": "#ffffff"
          }
        ]
      }
    },
    "PrimaryButton": {
      "props": {
        "label": "확인"
      },
      "view": {
        "id": "root",
        "box": "row",
        "height": 56,
        "align": "center",
        "justify": "center",
        "fill": "#d9ff00",
        "children": [
          {
            "id": "lbl",
            "text": "{props.label}",
            "size": 17,
            "weight": 800,
            "color": "#0b0c0e"
          }
        ]
      }
    }
  },
  "start": "lobby",
  "phases": {
    "lobby": {
      "tick": [
        {
          "if": "sessionPhase === 'countdown'",
          "then": [
            {
              "go": "countdown"
            }
          ]
        },
        {
          "if": "sessionPhase === 'play'",
          "then": [
            {
              "go": "play"
            }
          ]
        },
        {
          "if": "sessionPhase === 'result'",
          "then": [
            {
              "go": "result"
            }
          ]
        }
      ]
    },
    "countdown": {
      "tick": [
        {
          "if": "sessionPhase === 'lobby'",
          "then": [
            {
              "go": "lobby"
            }
          ]
        },
        {
          "if": "sessionPhase === 'play'",
          "then": [
            {
              "go": "play"
            }
          ]
        },
        {
          "if": "sessionPhase === 'result'",
          "then": [
            {
              "go": "result"
            }
          ]
        }
      ]
    },
    "play": {
      "enter": [
        {
          "set": "myTaps",
          "to": "0"
        },
        {
          "set": "sentTaps",
          "to": "0"
        },
        {
          "set": "sentAt",
          "to": "0"
        },
        {
          "set": "shownTotal",
          "to": "0"
        }
      ],
      "tick": [
        {
          "if": "myTaps > sentTaps && now - sentAt >= tapBatchMs",
          "then": [
            {
              "emit": "tally",
              "payload": {
                "delta": "{myTaps - sentTaps}"
              }
            },
            {
              "set": "sentTaps",
              "to": "myTaps"
            },
            {
              "set": "sentAt",
              "to": "now"
            }
          ]
        },
        {
          "if": "coopTotal > shownTotal",
          "then": [
            {
              "set": "shownTotal",
              "to": "coopTotal"
            }
          ]
        },
        {
          "if": "myTaps == sentTaps && now - sentAt >= 2000 && shownTotal != coopTotal",
          "then": [
            {
              "set": "shownTotal",
              "to": "coopTotal"
            }
          ]
        },
        {
          "if": "sessionPhase === 'lobby'",
          "then": [
            {
              "go": "lobby"
            }
          ]
        },
        {
          "if": "sessionPhase === 'countdown'",
          "then": [
            {
              "go": "countdown"
            }
          ]
        },
        {
          "if": "sessionPhase === 'result'",
          "then": [
            {
              "go": "result"
            }
          ]
        }
      ]
    },
    "result": {
      "tick": [
        {
          "if": "myTaps > sentTaps",
          "then": [
            {
              "emit": "tally",
              "payload": {
                "delta": "{myTaps - sentTaps}"
              }
            },
            {
              "set": "sentTaps",
              "to": "myTaps"
            }
          ]
        },
        {
          "if": "sessionPhase === 'lobby'",
          "then": [
            {
              "go": "lobby"
            }
          ]
        },
        {
          "if": "sessionPhase === 'countdown'",
          "then": [
            {
              "go": "countdown"
            }
          ]
        },
        {
          "if": "sessionPhase === 'play'",
          "then": [
            {
              "go": "play"
            }
          ]
        }
      ]
    }
  },
  "view": {
    "box": "free",
    "children": [
      {
        "id": "bg",
        "box": "free",
        "width": 390,
        "height": 844,
        "x": 0,
        "y": 0,
        "fill": "#0b0c0e"
      },
      {
        "id": "lobbyScreen",
        "box": "column",
        "width": 390,
        "height": 844,
        "x": 0,
        "y": 0,
        "gap": 14,
        "pad": [
          59,
          16,
          34,
          16
        ],
        "show": "phase == 'lobby'",
        "children": [
          {
            "id": "navL",
            "use": "NavBar",
            "props": {
              "title": "다 같이 게이지",
              "subtitle": "대기실"
            }
          },
          {
            "id": "lobbyCard",
            "box": "column",
            "width": 358,
            "height": 250,
            "grow": 1,
            "gap": 10,
            "pad": 18,
            "align": "center",
            "justify": "center",
            "fill": "#16181c",
            "children": [
              {
                "id": "lobbyEmoji",
                "text": "🤝",
                "size": 48,
                "align": "center"
              },
              {
                "id": "lobbyCount",
                "text": "{phase == 'lobby' ? (('참가자 ' + (roster.length) + '명')) : '참가자 1명'}",
                "width": 320,
                "size": 26,
                "weight": 700,
                "color": "#d9ff00",
                "align": "center"
              },
              {
                "id": "lobbyNames",
                "text": "{phase == 'lobby' ? (roster.length > 0 ? roster.join(' · ') : '입장 중…') : ''}",
                "width": 320,
                "size": 15,
                "weight": 600,
                "color": "#9aa3af",
                "align": "center"
              }
            ]
          },
          {
            "id": "lobbyHint",
            "text": "경쟁 아님! 다 같이 게이지를 시간 안에 채워요 · 15초 협동 연타",
            "width": 340,
            "size": 14,
            "weight": 500,
            "color": "#9aa3af",
            "align": "center"
          },
          {
            "id": "lobbySpacer",
            "box": "free",
            "width": "fill",
            "height": 1
          },
          {
            "id": "startBtn",
            "use": "PrimaryButton",
            "props": {
              "label": "시작하기 🚀"
            },
            "onTap": [
              {
                "if": "phase == 'lobby' && (roomMode == '' || (roomMode == 'host' && iAmHost) || (roomMode == 'auto' && autoStartIn <= 0 && roster.length >= 2))",
                "then": [
                  {
                    "set": "myTaps",
                    "to": "0"
                  },
                  {
                    "set": "sentTaps",
                    "to": "0"
                  },
                  {
                    "emit": "start",
                    "payload": {
                      "duration": 15000
                    }
                  }
                ]
              }
            ],
            "show": "(roomMode == '' || (roomMode == 'host' && iAmHost) || (roomMode == 'auto' && autoStartIn <= 0 && roster.length >= 2))"
          },
          {
            "id": "startWait",
            "box": "column",
            "width": "fill",
            "height": 56,
            "gap": 2,
            "align": "center",
            "justify": "center",
            "fill": "#16181c",
            "stroke": {
              "color": "#2a2d33",
              "width": 1
            },
            "show": "!(roomMode == '' || (roomMode == 'host' && iAmHost) || (roomMode == 'auto' && autoStartIn <= 0 && roster.length >= 2))",
            "children": [
              {
                "id": "startWaitMain",
                "text": "{roomMode == 'auto' ? (roster.length < 2 ? '한 명 더 오면 시작해요' : (autoStartIn + '초 뒤 시작 · ' + roster.length + '명')) : '방장이 시작하길 기다리는 중'}",
                "size": 16,
                "weight": 700,
                "color": "#d9ff00",
                "align": "center",
                "lines": 1
              },
              {
                "id": "startWaitSub",
                "text": "{roomMode == 'auto' ? (roster.length < 2 ? '링크를 친구에게 보내도 돼요' : '지금 들어온 사람 모두 같이 시작해요') : ('방장 · ' + hostNick)}",
                "size": 13,
                "weight": 600,
                "color": "#9aa3af",
                "align": "center",
                "lines": 1
              }
            ]
          }
        ]
      },
      {
        "id": "countdownScreen",
        "box": "column",
        "width": 390,
        "height": 844,
        "x": 0,
        "y": 0,
        "gap": 14,
        "pad": [
          59,
          16,
          34,
          16
        ],
        "show": "phase == 'countdown'",
        "children": [
          {
            "id": "navC",
            "use": "NavBar",
            "props": {
              "title": "다 같이 게이지",
              "subtitle": "곧 시작!"
            }
          },
          {
            "id": "cdCard",
            "box": "column",
            "width": "fill",
            "height": 420,
            "gap": 8,
            "pad": 18,
            "align": "center",
            "justify": "center",
            "fill": "#16181c",
            "children": [
              {
                "id": "cdNum",
                "text": "{phase == 'countdown' ? (sessionCountdown > 0 ? ('' + (sessionCountdown)) : 'GO!') : '3'}",
                "width": 320,
                "size": 140,
                "font": "display",
                "color": "#d9ff00",
                "align": "center"
              },
              {
                "id": "cdLabel",
                "text": "{phase == 'countdown' ? (sessionCountdown > 0 ? '준비…' : '채우자!') : '준비…'}",
                "width": 320,
                "size": 20,
                "weight": 700,
                "color": "#ffffff",
                "align": "center"
              }
            ]
          }
        ]
      },
      {
        "id": "playScreen",
        "box": "column",
        "width": 390,
        "height": 844,
        "x": 0,
        "y": 0,
        "gap": 14,
        "pad": [
          59,
          16,
          34,
          16
        ],
        "show": "phase == 'play'",
        "children": [
          {
            "id": "navP",
            "use": "NavBar",
            "props": {
              "title": "다 같이 게이지",
              "subtitle": "협동!"
            }
          },
          {
            "id": "goalCard",
            "box": "column",
            "width": 358,
            "height": 150,
            "gap": 8,
            "pad": 16,
            "align": "center",
            "justify": "center",
            "fill": "#16181c",
            "children": [
              {
                "id": "goalNum",
                "text": "{phase == 'play' ? (('' + (max(shownTotal, coopTotal)) + ' / ' + (max(60, roster.length * 50)))) : '0 / 60'}",
                "width": 320,
                "size": 34,
                "font": "display",
                "color": "#d9ff00",
                "align": "center"
              },
              {
                "id": "barWrap",
                "box": "free",
                "width": 320,
                "height": 18,
                "children": [
                  {
                    "id": "barTrack",
                    "box": "free",
                    "width": 320,
                    "height": 18,
                    "x": 0,
                    "y": 0,
                    "fill": "#2a2d33"
                  },
                  {
                    "id": "barFill",
                    "box": "free",
                    "width": "{phase == 'play' ? (max(6, round(min(1, max(shownTotal, coopTotal) / max(60, roster.length * 50)) * 320))) : 6}",
                    "height": 18,
                    "x": 0,
                    "y": 0,
                    "fill": "{phase == 'play' ? (max(shownTotal, coopTotal) >= max(60, roster.length * 50) ? '#22c55e' : '#d9ff00') : '#d9ff00'}"
                  }
                ]
              }
            ]
          },
          {
            "id": "tapArea",
            "box": "column",
            "width": "fill",
            "height": 300,
            "gap": 6,
            "align": "center",
            "justify": "center",
            "fill": "#d9ff00",
            "onTap": [
              {
                "if": "phase == 'play'",
                "then": [
                  {
                    "set": "myTaps",
                    "to": "myTaps + 1"
                  },
                  {
                    "set": "shownTotal",
                    "to": "max(shownTotal, coopTotal) + 1"
                  }
                ]
              }
            ],
            "children": [
              {
                "id": "tapBig",
                "text": "👆",
                "size": 72,
                "align": "center"
              },
              {
                "id": "tapTxt",
                "text": "다 같이 탭!",
                "size": 24,
                "weight": 700,
                "color": "#0b0c0e",
                "align": "center"
              }
            ]
          }
        ]
      },
      {
        "id": "resultScreen",
        "box": "column",
        "width": 390,
        "height": 844,
        "x": 0,
        "y": 0,
        "gap": 14,
        "pad": [
          59,
          16,
          34,
          16
        ],
        "show": "phase == 'result'",
        "children": [
          {
            "id": "navR",
            "use": "NavBar",
            "props": {
              "title": "다 같이 게이지",
              "subtitle": "결과"
            }
          },
          {
            "id": "resCard",
            "box": "column",
            "width": 358,
            "height": 280,
            "gap": 10,
            "pad": 18,
            "align": "center",
            "justify": "center",
            "fill": "#16181c",
            "children": [
              {
                "id": "resEmoji",
                "text": "{phase == 'result' ? (coopTotal >= max(60, roster.length * 50) ? '🎉' : '😅') : '🎉'}",
                "size": 64,
                "align": "center"
              },
              {
                "id": "resTitle",
                "text": "{phase == 'result' ? (coopTotal >= max(60, roster.length * 50) ? '성공! 다 같이 해냈어요' : '아쉽다… 조금 모자랐어요') : ''}",
                "width": 320,
                "size": 28,
                "weight": 700,
                "color": "#d9ff00",
                "align": "center"
              },
              {
                "id": "resSub",
                "text": "{phase == 'result' ? (('' + (coopTotal) + ' / ' + (max(60, roster.length * 50)) + ' 탭')) : ''}",
                "width": 320,
                "size": 16,
                "weight": 600,
                "color": "#d7dce3",
                "align": "center"
              },
              {
                "id": "resMine",
                "text": "{phase == 'result' ? (('내가 보탠 탭 ' + (myTaps) + '회')) : ''}",
                "width": 320,
                "size": 14,
                "weight": 600,
                "color": "#9aa3af",
                "align": "center"
              }
            ]
          },
          {
            "id": "resSpacer",
            "box": "free",
            "width": "fill",
            "height": 1,
            "grow": 1
          },
          {
            "id": "againBtn",
            "use": "PrimaryButton",
            "props": {
              "label": "{roomMode == 'auto' ? '한 판 더 🔁' : '다시 하기 🔁'}"
            },
            "onTap": [
              {
                "if": "phase == 'result' && (roomMode == '' || roomMode == 'auto' || (roomMode == 'host' && iAmHost))",
                "then": [
                  {
                    "set": "myTaps",
                    "to": "0"
                  },
                  {
                    "set": "sentTaps",
                    "to": "0"
                  },
                  {
                    "emit": "start",
                    "payload": {
                      "duration": 15000
                    }
                  }
                ]
              }
            ],
            "show": "(roomMode == '' || roomMode == 'auto' || (roomMode == 'host' && iAmHost))"
          },
          {
            "id": "againWait",
            "box": "column",
            "width": "fill",
            "height": 56,
            "gap": 2,
            "align": "center",
            "justify": "center",
            "fill": "#16181c",
            "stroke": {
              "color": "#2a2d33",
              "width": 1
            },
            "show": "!(roomMode == '' || roomMode == 'auto' || (roomMode == 'host' && iAmHost))",
            "children": [
              {
                "id": "againWaitMain",
                "text": "방장이 다시 시작하길 기다리는 중",
                "size": 16,
                "weight": 700,
                "color": "#d9ff00",
                "align": "center",
                "lines": 1
              },
              {
                "id": "againWaitSub",
                "text": "{'방장 · ' + hostNick}",
                "size": 13,
                "weight": 600,
                "color": "#9aa3af",
                "align": "center",
                "lines": 1
              }
            ]
          }
        ]
      }
    ]
  }
}
